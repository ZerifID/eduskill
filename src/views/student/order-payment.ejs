<div class="max-w-xl mx-auto my-12 px-4">
  <div class="bg-slate-900 border border-slate-800 rounded-2xl p-6 sm:p-8 shadow-xl">
    
    <!-- Header Status -->
    <div class="text-center pb-6 mb-6 border-b border-slate-800">
      <% if (order.status === 'paid') { %>
        <div class="w-16 h-16 rounded-2xl bg-emerald-500/10 text-emerald-400 flex items-center justify-center mx-auto mb-3 border border-emerald-500/20 shadow-lg shadow-emerald-500/10">
          <i data-lucide="circle-check" class="w-8 h-8"></i>
        </div>
        <h1 class="text-2xl font-bold text-white">Pembayaran Berhasil! 🎉</h1>
        <p class="text-xs text-emerald-400 font-medium mt-1">Hak akses kelas sudah aktif. Kamu bisa langsung mulai belajar!</p>
      <% } else { %>
        <div class="w-16 h-16 rounded-2xl bg-amber-500/10 text-amber-400 flex items-center justify-center mx-auto mb-3 border border-amber-500/20 animate-pulse">
          <i data-lucide="qr-code" class="w-8 h-8"></i>
        </div>
        <h1 class="text-2xl font-bold text-white">Selesaikan Pembayaran</h1>
        <p class="text-xs text-slate-400 mt-1">Scan QRIS di bawah ini atau klik link pembayaran.</p>
      <% } %>
    </div>

    <!-- Invoice Summary -->
    <div class="bg-slate-950 p-4 rounded-xl border border-slate-800/80 space-y-3 text-xs mb-6">
      <div class="flex justify-between">
        <span class="text-slate-400">Nomor Invoice</span>
        <span class="font-mono text-indigo-300 font-bold"><%= order.order_code %></span>
      </div>
      <div class="flex justify-between">
        <span class="text-slate-400">Kelas</span>
        <span class="font-semibold text-slate-200"><%= order.course_title %></span>
      </div>
      <div class="flex justify-between">
        <span class="text-slate-400">Metode</span>
        <span class="font-bold text-slate-200 uppercase"><%= order.payment_type || 'QRIS' %></span>
      </div>
      <div class="flex justify-between pt-2 border-t border-slate-800">
        <span class="text-slate-400 font-medium">Total Tagihan</span>
        <span class="text-base font-extrabold text-white">Rp <%= Number(order.amount).toLocaleString('id-ID') %></span>
      </div>
      <div class="flex justify-between items-center">
        <span class="text-slate-400">Status</span>
        <% if (order.status === 'paid') { %>
          <span class="px-2.5 py-0.5 rounded text-[10px] font-bold bg-emerald-500/10 text-emerald-400 border border-emerald-500/20">LUNAS (PAID)</span>
        <% } else { %>
          <span class="px-2.5 py-0.5 rounded text-[10px] font-bold bg-amber-500/10 text-amber-400 border border-amber-500/20">MENUNGGU PEMBAYARAN</span>
        <% } %>
      </div>
    </div>

    <!-- QRIS DISPLAY SECTION (Jika Belum Bayar) -->
    <% if (order.status !== 'paid') { %>
      <% if (order.qr_url) { %>
        <div class="bg-white p-5 rounded-2xl text-center mb-6 shadow-xl flex flex-col items-center">
          <span class="text-[11px] font-bold text-slate-800 uppercase tracking-wider mb-2">Scan QRIS untuk Membayar</span>
          <div class="w-56 h-56 bg-slate-100 rounded-xl overflow-hidden p-2 flex items-center justify-center border border-slate-200">
            <img src="<%= order.qr_url %>" alt="QRIS Payment" class="w-full h-full object-contain">
          </div>
          <p class="text-[11px] text-slate-500 mt-2">Dukung Gopay, OVO, Dana, ShopeePay, BCA, Mandiri & Semua Bank.</p>
        </div>
      <% } %>

      <!-- <div class="space-y-3 mb-6">
        <% if (order.payment_url) { %>
          <a href="<%= order.payment_url %>" target="_blank" class="w-full py-3 bg-indigo-600 hover:bg-indigo-500 text-white font-bold rounded-xl text-sm shadow-lg shadow-indigo-600/25 transition-all flex items-center justify-center gap-2">
            <i data-lucide="external-link" class="w-4 h-4"></i> Buka Halaman Checkout Pembayaran
          </a>
        <% } %>

        <form action="/orders/<%= order.order_code %>/simulate-pay" method="POST">
          <button type="submit" class="w-full py-2.5 bg-slate-800 hover:bg-slate-700 text-slate-300 font-semibold rounded-xl text-xs border border-slate-700 transition-colors flex items-center justify-center gap-2">
            <i data-lucide="zap" class="w-3.5 h-3.5 text-amber-400"></i> Simulasi Bayar Instan (Khusus Testing)
          </button>
        </form>
      </div> -->

      <div class="p-3 bg-slate-950 rounded-xl border border-slate-800 text-[11px] text-slate-400 text-center">
        <span class="inline-block animate-spin mr-1">⏳</span> Menunggu konfirmasi webhook otomatis dari sistem payment...
      </div>
    <% } else { %>
      <!-- Tombol Masuk Kelas Setelah Lunas -->
      <a href="/course/<%= order.course_slug %>/learn" class="w-full py-3.5 bg-indigo-600 hover:bg-indigo-500 text-white font-bold rounded-xl text-sm shadow-lg shadow-indigo-600/25 transition-all flex items-center justify-center gap-2">
        <i data-lucide="play" class="w-4 h-4"></i> Masuk Classroom & Mulai Belajar
      </a>
    <% } %>

    <div class="text-center pt-4">
      <a href="/course/<%= order.course_slug %>" class="text-xs text-slate-400 hover:text-white transition-colors">
        &larr; Kembali ke Detail Kelas
      </a>
    </div>

  </div>
</div>

<% if (order.status !== 'paid') { %>
<script>
  // Auto-polling status pembayaran tiap 4 detik (refresh otomatis kalau sudah lunas via webhook)
  setInterval(async () => {
    try {
      const res = await fetch(window.location.href);
      const html = await res.text();
      if (html.includes('LUNAS (PAID)')) {
        window.location.reload();
      }
    } catch (e) {}
  }, 4000);
</script>
<% } %>
