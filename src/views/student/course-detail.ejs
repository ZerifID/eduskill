<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10">
  <div class="grid grid-cols-1 lg:grid-cols-3 gap-10">
    
    <!-- Left 2 Cols: Course Overview & Modul Tree Syllabus -->
    <div class="lg:col-span-2 space-y-8">
      <div>
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-indigo-500/10 text-indigo-400 text-xs font-semibold mb-3">
          <i data-lucide="book-open" class="w-3.5 h-3.5"></i> Silabus & Modul Tree
        </div>
        <h1 class="text-3xl sm:text-4xl font-extrabold text-white tracking-tight"><%= course.title %></h1>
        <p class="text-sm text-slate-400 mt-3 leading-relaxed"><%= course.description || 'Pelajari materi ini langkah demi langkah untuk menguasai skill secara menyeluruh.' %></p>
      </div>

      <!-- Modul Tree Syllabus View -->
      <div class="bg-slate-900 border border-slate-800 rounded-2xl p-6 shadow-xl">
        <div class="flex items-center justify-between mb-6 pb-4 border-b border-slate-800">
          <div>
            <h2 class="text-base font-bold text-white flex items-center gap-2">
              <i data-lucide="network" class="w-5 h-5 text-indigo-400"></i> Struktur Kurikulum (Modul Tree)
            </h2>
            <p class="text-xs text-slate-400 mt-0.5">Materi dengan label <span class="text-emerald-400 font-semibold">Free Preview 🔓</span> bisa dicoba langsung!</p>
          </div>
          <span class="text-xs text-slate-400 font-medium"><%= totalLessons %> Materi</span>
        </div>

        <% if (moduleTree.length === 0) { %>
          <div class="text-center py-8 text-slate-500 text-xs">
            Belum ada silabus yang ditambahkan ke kelas ini.
          </div>
        <% } %>

        <div class="space-y-4">
          <% moduleTree.forEach((m, mIdx) => { %>
            <div class="border border-slate-800/80 rounded-xl bg-slate-950/60 overflow-hidden">
              <!-- Bab Header -->
              <div class="px-4 py-3 bg-slate-800/40 border-b border-slate-800/60 flex items-center justify-between">
                <div class="flex items-center gap-3">
                  <span class="w-6 h-6 rounded-lg bg-indigo-600/20 text-indigo-400 text-xs font-bold flex items-center justify-center border border-indigo-500/20">
                    <%= mIdx + 1 %>
                  </span>
                  <span class="font-bold text-sm text-slate-200"><%= m.title %></span>
                </div>
                <span class="text-[11px] text-slate-500"><%= m.lessons.length %> Materi</span>
              </div>

              <!-- List Materi -->
              <div class="p-2 space-y-1.5">
                <% m.lessons.forEach(l => { %>
                  <div class="flex items-center justify-between px-3 py-2 rounded-lg hover:bg-slate-900 transition-colors text-xs">
                    <div class="flex items-center gap-2.5">
                      <i data-lucide="<%= l.content_type === 'video' ? 'circle-play' : 'file-text' %>" class="w-4 h-4 <%= l.content_type === 'video' ? 'text-indigo-400' : 'text-amber-400' %> shrink-0"></i>
                      <span class="text-slate-300 font-medium"><%= l.title %></span>
                    </div>

                    <div>
                      <% if (l.is_preview === 1 || isEnrolled) { %>
                        <a href="/course/<%= course.slug %>/learn?lesson=<%= l.id %>" class="px-2.5 py-1 rounded-md text-[11px] font-bold bg-emerald-500/10 text-emerald-400 hover:bg-emerald-500/20 border border-emerald-500/20 flex items-center gap-1 transition-colors">
                          <i data-lucide="<%= l.content_type === 'video' ? 'play' : 'book-open' %>" class="w-3 h-3"></i> <%= l.content_type === 'video' ? 'Tonton' : 'Baca' %>
                        </a>
                      <% } else { %>
                        <span class="px-2 py-1 rounded text-[10px] font-semibold bg-slate-800 text-slate-500 flex items-center gap-1 cursor-not-allowed">
                          <i data-lucide="lock" class="w-3 h-3"></i> Terkunci
                        </span>
                      <% } %>
                    </div>
                  </div>
                <% }) %>

                <!-- Sub-Modul / Branch -->
                <% m.submodules.forEach(sub => { %>
                  <div class="ml-5 mt-2 border-l-2 border-indigo-500/30 pl-3 space-y-1.5">
                    <div class="text-xs font-semibold text-indigo-300 py-1 flex items-center gap-1.5">
                      <i data-lucide="corner-down-right" class="w-3.5 h-3.5"></i> <%= sub.title %>
                    </div>
                    <% sub.lessons.forEach(subL => { %>
                      <div class="flex items-center justify-between px-3 py-1.5 rounded-lg hover:bg-slate-900 transition-colors text-xs">
                        <div class="flex items-center gap-2">
                          <i data-lucide="<%= subL.content_type === 'video' ? 'circle-play' : 'file-text' %>" class="w-3.5 h-3.5 text-slate-400"></i>
                          <span class="text-slate-300"><%= subL.title %></span>
                        </div>
                        <div>
                          <% if (subL.is_preview === 1 || isEnrolled) { %>
                            <a href="/course/<%= course.slug %>/learn?lesson=<%= subL.id %>" class="text-[10px] font-bold text-emerald-400 hover:underline">
                              <%= subL.content_type === 'video' ? 'Tonton Gratis 🔓' : 'Baca Gratis 🔓' %>
                            </a>
                          <% } else { %>
                            <span class="text-[10px] text-slate-600 flex items-center gap-1">
                              <i data-lucide="lock" class="w-3 h-3"></i> Locked
                            </span>
                          <% } %>
                        </div>
                      </div>
                    <% }) %>
                  </div>
                <% }) %>
              </div>
            </div>
          <% }) %>
        </div>
      </div>
    </div>

    <!-- Right 1 Col: Sticky Pricing Card & Action -->
    <div>
      <div class="sticky top-24 bg-slate-900 border border-slate-800 rounded-2xl p-6 shadow-2xl space-y-6">
        <div class="aspect-video bg-slate-950 rounded-xl overflow-hidden border border-slate-800 relative">
          <% if (course.thumbnail_url) { %>
            <img src="<%= course.thumbnail_url %>" alt="<%= course.title %>" class="w-full h-full object-cover">
          <% } else { %>
            <div class="w-full h-full flex items-center justify-center bg-gradient-to-tr from-indigo-950 to-slate-900 text-indigo-400">
              <i data-lucide="graduation-cap" class="w-12 h-12 opacity-60"></i>
            </div>
          <% } %>
        </div>

        <div>
          <span class="text-xs text-slate-400 block font-medium">Harga Investasi Belajar:</span>
          <div class="text-3xl font-extrabold text-white mt-1">
            <%= course.price === 0 ? 'GRATIS' : 'Rp ' + Number(course.price).toLocaleString('id-ID') %>
          </div>
        </div>

        <div class="space-y-3 pt-2">
          <% if (isEnrolled) { %>
            <div class="p-3 bg-emerald-500/10 border border-emerald-500/20 rounded-xl text-center text-xs text-emerald-400 font-semibold mb-2">
              Kamu sudah terdaftar di kelas ini!
            </div>
            <a href="/course/<%= course.slug %>/learn" class="w-full py-3 bg-indigo-600 hover:bg-indigo-500 text-white font-bold rounded-xl text-sm shadow-lg shadow-indigo-600/25 transition-all flex items-center justify-center gap-2">
              <i data-lucide="play" class="w-4 h-4"></i> Lanjut Belajar di Classroom
            </a>
          <% } else { %>
            <a href="/orders/checkout?courseId=<%= course.id %>" class="w-full py-3 bg-indigo-600 hover:bg-indigo-500 text-white font-bold rounded-xl text-sm shadow-lg shadow-indigo-600/25 transition-all flex items-center justify-center gap-2">
              <i data-lucide="shopping-cart" class="w-4 h-4"></i> <%= course.price === 0 ? 'Daftar Kelas Gratis' : 'Beli & Buka Semua Modul' %>
            </a>
            <a href="/course/<%= course.slug %>/learn" class="w-full py-2.5 bg-slate-800 hover:bg-slate-700 text-slate-200 font-semibold rounded-xl text-xs border border-slate-700 transition-colors flex items-center justify-center gap-2">
              <i data-lucide="eye" class="w-4 h-4 text-emerald-400"></i> Coba Tester (Free Preview)
            </a>
          <% } %>
        </div>

        <div class="border-t border-slate-800 pt-4 space-y-2.5 text-xs text-slate-400">
          <div class="flex items-center gap-2">
            <i data-lucide="circle-check" class="w-4 h-4 text-indigo-400"></i> Akses seumur hidup
          </div>
          <div class="flex items-center gap-2">
            <i data-lucide="circle-check" class="w-4 h-4 text-indigo-400"></i> Kurikulum Modul Tree terarah
          </div>
          <div class="flex items-center gap-2">
            <i data-lucide="circle-check" class="w-4 h-4 text-indigo-400"></i> Pembayaran otomatis via Webhook
          </div>
        </div>
      </div>
    </div>

  </div>
</div>
