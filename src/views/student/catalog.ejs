<!-- Hero Section -->
<div class="relative overflow-hidden py-16 sm:py-24 border-b border-slate-800/80 bg-gradient-to-b from-indigo-950/30 via-slate-950 to-slate-950">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center relative z-10">
    <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-indigo-500/10 border border-indigo-500/20 text-indigo-300 text-xs font-semibold mb-6">
      <i data-lucide="zap" class="w-3.5 h-3.5 text-indigo-400"></i> Platform Belajar Skill Masa Depan
    </div>
    <h1 class="text-4xl sm:text-6xl font-extrabold text-white tracking-tight leading-tight max-w-3xl mx-auto">
      Tingkatkan Skill Coding & Karirmu Sekarang.
    </h1>
    <p class="text-slate-400 text-sm sm:text-base max-w-2xl mx-auto mt-4">
      Belajar terstruktur dengan alur Modul Tree, coba materi tester gratis (Free Preview), dan bayar praktis dengan otomatisasi webhook.
    </p>
    <div class="mt-8 flex items-center justify-center gap-4">
      <a href="#katalog" class="px-6 py-3 bg-indigo-600 hover:bg-indigo-500 text-white font-semibold text-sm rounded-xl shadow-lg shadow-indigo-600/25 transition-all flex items-center gap-2">
        <i data-lucide="compass" class="w-4 h-4"></i> Jelajahi Kelas
      </a>
      <% if (!currentUser) { %>
        <a href="/auth/register" class="px-6 py-3 bg-slate-800 hover:bg-slate-700 text-slate-200 font-semibold text-sm rounded-xl border border-slate-700 transition-colors">
          Daftar Gratis
        </a>
      <% } %>
    </div>
  </div>
</div>

<!-- Catalog Grid -->
<div id="katalog" class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
  <div class="flex items-center justify-between mb-8">
    <div>
      <h2 class="text-2xl font-bold text-white tracking-tight">Katalog Kelas Pilihan</h2>
      <p class="text-xs text-slate-400 mt-1">Pilih kelas yang sesuai dengan minat & target belajarmu.</p>
    </div>
    <span class="text-xs text-slate-400"><%= courses.length %> Kelas Tersedia</span>
  </div>

  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
    <% if (courses.length === 0) { %>
      <div class="col-span-full py-16 text-center text-slate-500 bg-slate-900 border border-slate-800 rounded-2xl">
        <i data-lucide="inbox" class="w-12 h-12 mx-auto mb-2 opacity-50"></i>
        <p class="text-sm font-medium">Belum ada kelas yang dipublikasikan.</p>
        <p class="text-xs text-slate-600">Admin dapat menambahkan kelas melalui Admin Panel.</p>
      </div>
    <% } %>

    <% courses.forEach(c => { %>
      <div class="bg-slate-900 border border-slate-800 rounded-2xl overflow-hidden flex flex-col hover:border-indigo-500/50 hover:shadow-xl hover:shadow-indigo-500/5 transition-all group">
        <!-- Thumbnail -->
        <a href="/course/<%= c.slug %>" class="aspect-video bg-slate-950 relative overflow-hidden block">
          <% if (c.thumbnail_url) { %>
            <img src="<%= c.thumbnail_url %>" alt="<%= c.title %>" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300">
          <% } else { %>
            <div class="w-full h-full flex items-center justify-center bg-gradient-to-tr from-slate-900 to-indigo-950 text-indigo-400 group-hover:scale-105 transition-transform duration-300">
              <i data-lucide="code" class="w-12 h-12 opacity-50"></i>
            </div>
          <% } %>
          <div class="absolute bottom-3 left-3 bg-slate-950/80 backdrop-blur-md px-2.5 py-1 rounded-lg text-[11px] font-semibold text-slate-300 flex items-center gap-1.5 border border-slate-800">
            <i data-lucide="play" class="w-3 h-3 text-indigo-400"></i> <%= c.total_lessons %> Materi
          </div>
        </a>

        <!-- Content -->
        <div class="p-5 flex-1 flex flex-col">
          <h3 class="font-bold text-white text-base leading-snug mb-2 group-hover:text-indigo-400 transition-colors">
            <a href="/course/<%= c.slug %>"><%= c.title %></a>
          </h3>
          <p class="text-xs text-slate-400 line-clamp-2 mb-6 flex-1"><%= c.description || 'Pelajari materi lengkap dan bangun portofolio impian.' %></p>

          <div class="pt-4 border-t border-slate-800 flex items-center justify-between">
            <div>
              <span class="text-[10px] text-slate-500 block uppercase font-bold tracking-wider">Investasi</span>
              <span class="text-sm font-extrabold text-white">
                <%= c.price === 0 ? 'GRATIS' : 'Rp ' + Number(c.price).toLocaleString('id-ID') %>
              </span>
            </div>
            <a href="/course/<%= c.slug %>" class="px-4 py-2 bg-indigo-600/10 hover:bg-indigo-600 text-indigo-400 hover:text-white border border-indigo-500/20 rounded-xl text-xs font-semibold transition-all flex items-center gap-1">
              Lihat Detail <i data-lucide="chevron-right" class="w-3.5 h-3.5"></i>
            </a>
          </div>
        </div>
      </div>
    <% }) %>
  </div>
</div>
