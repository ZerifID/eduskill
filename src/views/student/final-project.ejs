<div class="min-h-screen py-10 bg-gradient-to-b from-slate-950 via-slate-900 to-slate-950 text-slate-100">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Top Breadcrumb & Navigation -->
    <div class="flex flex-wrap items-center justify-between gap-4 mb-6">
      <nav class="flex items-center gap-2 text-xs font-medium text-slate-400">
        <a href="/my-courses" class="hover:text-indigo-400 transition-colors flex items-center gap-1.5">
          <i data-lucide="layout-grid" class="w-3.5 h-3.5"></i> Kelas Saya
        </a>
        <span class="text-slate-600">/</span>
        <a href="/course/<%= course.slug %>/learn" class="hover:text-indigo-400 transition-colors flex items-center gap-1.5">
          <i data-lucide="play-circle" class="w-3.5 h-3.5"></i> <%= course.title %>
        </a>
        <span class="text-slate-600">/</span>
        <span class="text-indigo-400 font-semibold">Tugas Akhir</span>
      </nav>

      <a href="/course/<%= course.slug %>/learn" class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-xl bg-slate-900/80 hover:bg-slate-800 border border-slate-800 text-xs font-semibold text-slate-300 hover:text-white transition-all shadow-sm">
        <i data-lucide="arrow-left" class="w-3.5 h-3.5 text-indigo-400"></i> Kembali ke Materi Kelas
      </a>
    </div>

    <!-- Hero Header Card with Ambient Glow -->
    <div class="relative overflow-hidden rounded-3xl bg-gradient-to-r from-indigo-950/60 via-slate-900 to-violet-950/60 border border-indigo-500/20 p-6 sm:p-8 mb-8 shadow-2xl backdrop-blur-xl">
      <div class="absolute -top-24 -right-24 w-72 h-72 bg-indigo-500/10 rounded-full blur-3xl pointer-events-none"></div>
      <div class="absolute -bottom-24 -left-24 w-72 h-72 bg-violet-500/10 rounded-full blur-3xl pointer-events-none"></div>
      
      <div class="relative z-10 flex flex-col md:flex-row md:items-center justify-between gap-6">
        <div class="space-y-3 max-w-2xl">
          <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-[11px] font-bold tracking-wide uppercase bg-indigo-500/10 text-indigo-400 border border-indigo-500/20 backdrop-blur-md">
            <i data-lucide="sparkles" class="w-3.5 h-3.5 text-amber-400"></i> Syarat Kelulusan & Sertifikat
          </div>
          <h1 class="text-2xl sm:text-4xl font-extrabold text-white tracking-tight leading-tight">
            Pengumpulan <span class="bg-clip-text text-transparent bg-gradient-to-r from-indigo-400 via-purple-300 to-violet-400">Tugas Akhir</span>
          </h1>
          <p class="text-xs sm:text-sm text-slate-300 leading-relaxed">
            Selesaikan tantangan proyek untuk kelas <span class="font-semibold text-white">"<%= course.title %>"</span>. Buktikan pemahamanmu untuk meraih sertifikat kelulusan terverifikasi!
          </p>
        </div>

        <!-- Quick Status Badge on Hero -->
        <div class="flex flex-col sm:flex-row items-start sm:items-center gap-3">
          <% if (submission && submission.status === 'approved') { %>
            <div class="px-5 py-3 rounded-2xl bg-emerald-500/15 border border-emerald-500/30 text-emerald-300 text-xs font-bold flex items-center gap-2.5 shadow-lg shadow-emerald-500/10">
              <div class="w-7 h-7 rounded-xl bg-emerald-500/20 flex items-center justify-center text-emerald-400">
                <i data-lucide="award" class="w-4 h-4"></i>
              </div>
              <div>
                <div class="text-[10px] text-emerald-400 uppercase font-semibold">Hasil Evaluasi</div>
                <div>LULUS & BERSERTIFIKAT</div>
              </div>
            </div>
            <% if (submission.certificate_code) { %>
              <a href="/certificate/<%= submission.certificate_code %>" class="px-5 py-3 rounded-2xl bg-gradient-to-r from-amber-500 to-yellow-500 hover:from-amber-400 hover:to-yellow-400 text-slate-950 text-xs font-extrabold flex items-center gap-2 shadow-lg shadow-amber-500/20 transition-all hover:scale-105">
                <i data-lucide="external-link" class="w-4 h-4"></i> Lihat Sertifikat
              </a>
            <% } %>
          <% } else if (submission && submission.status === 'pending') { %>
            <div class="px-5 py-3 rounded-2xl bg-amber-500/10 border border-amber-500/30 text-amber-300 text-xs font-bold flex items-center gap-2.5 shadow-lg">
              <div class="w-7 h-7 rounded-xl bg-amber-500/20 flex items-center justify-center text-amber-400 animate-spin">
                <i data-lucide="loader-2" class="w-4 h-4"></i>
              </div>
              <div>
                <div class="text-[10px] text-amber-400 uppercase font-semibold">Status Pengajuan</div>
                <div>SEDANG DI-REVIEW</div>
              </div>
            </div>
          <% } else if (submission && submission.status === 'rejected') { %>
            <div class="px-5 py-3 rounded-2xl bg-rose-500/10 border border-rose-500/30 text-rose-300 text-xs font-bold flex items-center gap-2.5 shadow-lg">
              <div class="w-7 h-7 rounded-xl bg-rose-500/20 flex items-center justify-center text-rose-400">
                <i data-lucide="alert-circle" class="w-4 h-4"></i>
              </div>
              <div>
                <div class="text-[10px] text-rose-400 uppercase font-semibold">Status Pengajuan</div>
                <div>PERLU REVISI TUGAS</div>
              </div>
            </div>
          <% } else { %>
            <div class="px-5 py-3 rounded-2xl bg-slate-800/80 border border-slate-700 text-slate-300 text-xs font-semibold flex items-center gap-2.5">
              <div class="w-7 h-7 rounded-xl bg-slate-700/50 flex items-center justify-center text-indigo-400">
                <i data-lucide="clock" class="w-4 h-4"></i>
              </div>
              <div>
                <div class="text-[10px] text-slate-400 uppercase font-semibold">Status</div>
                <div>Belum Dikumpulkan</div>
              </div>
            </div>
          <% } %>
        </div>
      </div>

      <!-- Roadmap / Stepper Indicator -->
      <div class="grid grid-cols-1 sm:grid-cols-4 gap-3 mt-8 pt-6 border-t border-slate-800/80">
        <div class="flex items-center gap-3 p-2.5 rounded-xl bg-slate-900/50 border border-slate-800">
          <div class="w-7 h-7 rounded-lg bg-emerald-500/20 text-emerald-400 flex items-center justify-center text-xs font-bold shrink-0">1</div>
          <div class="min-w-0">
            <div class="text-xs font-bold text-white truncate">Pelajari Materi</div>
            <div class="text-[10px] text-slate-400">Selesaikan silabus</div>
          </div>
        </div>
        <div class="flex items-center gap-3 p-2.5 rounded-xl <%= submission ? 'bg-slate-900/50 border-slate-800' : 'bg-indigo-500/10 border-indigo-500/30' %> border">
          <div class="w-7 h-7 rounded-lg <%= submission ? 'bg-emerald-500/20 text-emerald-400' : 'bg-indigo-600 text-white' %> flex items-center justify-center text-xs font-bold shrink-0">2</div>
          <div class="min-w-0">
            <div class="text-xs font-bold text-white truncate">Kerjakan & Upload</div>
            <div class="text-[10px] text-slate-400">Submit tugas kamu</div>
          </div>
        </div>
        <div class="flex items-center gap-3 p-2.5 rounded-xl <%= submission && submission.status === 'pending' ? 'bg-amber-500/10 border-amber-500/30' : 'bg-slate-900/50 border-slate-800' %> border">
          <div class="w-7 h-7 rounded-lg <%= submission && submission.status === 'approved' ? 'bg-emerald-500/20 text-emerald-400' : (submission && submission.status === 'pending' ? 'bg-amber-500/20 text-amber-400' : 'bg-slate-800 text-slate-400') %> flex items-center justify-center text-xs font-bold shrink-0">3</div>
          <div class="min-w-0">
            <div class="text-xs font-bold text-white truncate">Review Instruktur</div>
            <div class="text-[10px] text-slate-400">Feedback & penilaian</div>
          </div>
        </div>
        <div class="flex items-center gap-3 p-2.5 rounded-xl <%= submission && submission.status === 'approved' ? 'bg-emerald-500/10 border-emerald-500/30' : 'bg-slate-900/50 border-slate-800' %> border">
          <div class="w-7 h-7 rounded-lg <%= submission && submission.status === 'approved' ? 'bg-emerald-500 text-white' : 'bg-slate-800 text-slate-400' %> flex items-center justify-center text-xs font-bold shrink-0">4</div>
          <div class="min-w-0">
            <div class="text-xs font-bold text-white truncate">Klaim Sertifikat</div>
            <div class="text-[10px] text-slate-400">Verifikasi barcode</div>
          </div>
        </div>
      </div>
    </div>

    <!-- Main Content Layout -->
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
      
      <!-- Left Column (2 Cols): Project Brief, Review Status & Submission Form -->
      <div class="lg:col-span-2 space-y-6">
        
        <!-- Project Instructions & Brief Card -->
        <div class="bg-slate-900 border border-slate-800 rounded-3xl p-6 sm:p-8 shadow-xl relative overflow-hidden">
          <div class="flex items-center justify-between pb-5 mb-5 border-b border-slate-800">
            <div class="flex items-center gap-3.5">
              <div class="w-11 h-11 rounded-2xl bg-indigo-600/20 border border-indigo-500/30 text-indigo-400 flex items-center justify-center shadow-lg shadow-indigo-600/10">
                <i data-lucide="book-marked" class="w-5 h-5"></i>
              </div>
              <div>
                <span class="text-[10px] font-bold text-indigo-400 uppercase tracking-widest block">Instruksi Proyek</span>
                <h2 class="text-lg sm:text-xl font-bold text-white"><%= course.final_project_title || 'Proyek Kelulusan' %></h2>
              </div>
            </div>
            
            <span class="hidden sm:inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-semibold bg-slate-800 text-slate-300 border border-slate-700">
              <i data-lucide="check-circle-2" class="w-3.5 h-3.5 text-emerald-400"></i> Wajib Dikerjakan
            </span>
          </div>

          <!-- Instruction Text with Markdown style formatting -->
          <div class="article-content max-w-none bg-slate-950/60 p-5 sm:p-6 rounded-2xl border border-slate-800/80">
            <% if (typeof renderedInstructionsHtml !== 'undefined' && renderedInstructionsHtml) { %>
              <%- renderedInstructionsHtml %>
            <% } else { %>
              <p class="text-slate-400 text-xs sm:text-sm"><%= course.final_project_instructions || 'Kerjakan tugas akhir sesuai standar instruksi materi kelas dan kirimkan hasil kerjamu di bawah ini.' %></p>
            <% } %>
          </div>

          <!-- Submission Guidelines Checklist -->
          <div class="mt-6 pt-5 border-t border-slate-800/80 grid grid-cols-1 sm:grid-cols-2 gap-3 text-xs text-slate-300">
            <div class="flex items-center gap-2.5 p-3 rounded-xl bg-slate-950/40 border border-slate-800">
              <i data-lucide="file-archive" class="w-4 h-4 text-indigo-400 shrink-0"></i>
              <span>File upload: ZIP / RAR / PDF (Maks 50MB)</span>
            </div>
            <div class="flex items-center gap-2.5 p-3 rounded-xl bg-slate-950/40 border border-slate-800">
              <i data-lucide="link-2" class="w-4 h-4 text-indigo-400 shrink-0"></i>
              <span>Link eksternal: GitHub, Vercel, GDrive</span>
            </div>
          </div>
        </div>

        <!-- Submission Status History & Feedback (If already submitted) -->
        <% if (submission) { %>
          <div class="bg-slate-900 border <%= submission.status === 'approved' ? 'border-emerald-500/40' : (submission.status === 'rejected' ? 'border-rose-500/40' : 'border-amber-500/30') %> rounded-3xl p-6 sm:p-8 shadow-xl relative overflow-hidden">
            
            <div class="flex items-center justify-between pb-5 mb-5 border-b border-slate-800">
              <div class="flex items-center gap-3">
                <div class="w-10 h-10 rounded-2xl <%= submission.status === 'approved' ? 'bg-emerald-500/20 text-emerald-400' : (submission.status === 'rejected' ? 'bg-rose-500/20 text-rose-400' : 'bg-amber-500/20 text-amber-400') %> flex items-center justify-center">
                  <i data-lucide="<%= submission.status === 'approved' ? 'award' : (submission.status === 'rejected' ? 'alert-triangle' : 'clock') %>" class="w-5 h-5"></i>
                </div>
                <div>
                  <h3 class="text-base font-bold text-white">Status Pengerjaan Kamu</h3>
                  <p class="text-[11px] text-slate-400">Pengajuan tugas terakhir yang tersimpan di sistem</p>
                </div>
              </div>

              <% if (submission.status === 'approved') { %>
                <span class="px-3 py-1.5 rounded-xl text-xs font-extrabold bg-emerald-500/20 text-emerald-300 border border-emerald-500/40 flex items-center gap-1.5 shadow-md shadow-emerald-500/10">
                  <i data-lucide="check-check" class="w-4 h-4"></i> Lulus (Approved)
                </span>
              <% } else if (submission.status === 'rejected') { %>
                <span class="px-3 py-1.5 rounded-xl text-xs font-extrabold bg-rose-500/20 text-rose-300 border border-rose-500/40 flex items-center gap-1.5 shadow-md shadow-rose-500/10">
                  <i data-lucide="x-circle" class="w-4 h-4"></i> Perlu Revisi
                </span>
              <% } else { %>
                <span class="px-3 py-1.5 rounded-xl text-xs font-bold bg-amber-500/15 text-amber-300 border border-amber-500/30 flex items-center gap-1.5">
                  <i data-lucide="hourglass" class="w-3.5 h-3.5 animate-spin"></i> Dalam Antrean Review
                </span>
              <% } %>
            </div>

            <!-- Catatan Feedback Instruktur -->
            <% if (submission.admin_feedback) { %>
              <div class="mb-5 p-4 sm:p-5 rounded-2xl <%= submission.status === 'approved' ? 'bg-emerald-950/40 border border-emerald-500/30 text-emerald-200' : 'bg-rose-950/40 border border-rose-500/30 text-rose-200' %>">
                <div class="flex items-center gap-2 mb-2 font-bold text-xs <%= submission.status === 'approved' ? 'text-emerald-400' : 'text-rose-400' %>">
                  <i data-lucide="message-square-quote" class="w-4 h-4"></i> Catatan & Evaluasi dari Instruktur:
                </div>
                <p class="text-xs sm:text-sm leading-relaxed whitespace-pre-line pl-6 border-l-2 <%= submission.status === 'approved' ? 'border-emerald-500/40' : 'border-rose-500/40' %>">
                  <%= submission.admin_feedback %>
                </p>
              </div>
            <% } %>

            <!-- Submitted Details Preview -->
            <div class="space-y-3.5 bg-slate-950 p-5 rounded-2xl border border-slate-800/80 text-xs">
              
              <% if (submission.text_content || submission.submission_notes || submission.submission_link) { %>
                <% const finalContent = submission.text_content || submission.submission_notes || submission.submission_link; %>
                <div>
                  <span class="text-slate-400 font-semibold block mb-1.5 flex items-center gap-1.5">
                    <i data-lucide="align-left" class="w-3.5 h-3.5 text-indigo-400"></i> Catatan & Link Tugas Terkirim:
                  </span>
                  <div class="p-3.5 bg-slate-900 rounded-xl border border-slate-800 text-slate-200 font-mono text-xs whitespace-pre-line leading-relaxed break-all">
                    <%= finalContent %>
                  </div>
                </div>
              <% } %>

              <% const uploadedFile = submission.file_url || submission.file_path; %>
              <% if (uploadedFile) { %>
                <div class="pt-3 border-t border-slate-800/80 flex flex-col sm:flex-row sm:items-center justify-between gap-3">
                  <div class="flex items-center gap-3 min-w-0">
                    <div class="w-9 h-9 rounded-xl bg-indigo-600/20 text-indigo-400 flex items-center justify-center shrink-0">
                      <i data-lucide="paperclip" class="w-4 h-4"></i>
                    </div>
                    <div class="min-w-0">
                      <span class="text-[11px] text-slate-400 block">File Lampiran Proyek:</span>
                      <span class="font-semibold text-slate-100 text-xs truncate block"><%= submission.file_name || 'Berkas Tugas Akhir' %></span>
                    </div>
                  </div>
                  <a href="<%= uploadedFile %>" download class="px-4 py-2 bg-slate-800 hover:bg-slate-700 text-slate-200 hover:text-white rounded-xl text-xs font-semibold flex items-center justify-center gap-1.5 border border-slate-700 transition-all shrink-0">
                    <i data-lucide="download" class="w-3.5 h-3.5"></i> Unduh File
                  </a>
                </div>
              <% } %>

              <div class="text-[11px] text-slate-400 pt-3 border-t border-slate-800/80 flex flex-wrap items-center justify-between gap-2">
                <span>Dikirim pada: <strong class="text-slate-300"><%= new Date(submission.created_at || submission.updated_at).toLocaleString('id-ID') %></strong></span>
                <% if (submission.certificate_code) { %>
                  <span class="font-mono text-indigo-400 font-semibold">Kode: <%= submission.certificate_code %></span>
                <% } %>
              </div>
            </div>

            <% if (submission.status === 'approved' && submission.certificate_code) { %>
              <div class="mt-6 pt-5 border-t border-slate-800 flex justify-end">
                <a href="/certificate/<%= submission.certificate_code %>" class="w-full sm:w-auto px-6 py-3 bg-gradient-to-r from-amber-500 to-yellow-500 hover:from-amber-400 hover:to-yellow-400 text-slate-950 font-extrabold rounded-2xl text-xs flex items-center justify-center gap-2 shadow-lg shadow-amber-500/25 transition-all">
                  <i data-lucide="award" class="w-4 h-4"></i> Buka Halaman Sertifikat Digital
                </a>
              </div>
            <% } %>

          </div>
        <% } %>

        <!-- Submission Form Box (Only shown if never submitted or rejected) -->
        <% if (!submission || submission.status === 'rejected') { %>
          <div class="bg-slate-900 border border-slate-800 rounded-3xl p-6 sm:p-8 shadow-xl relative overflow-hidden">
            
            <div class="pb-5 mb-6 border-b border-slate-800">
              <div class="flex items-center gap-3">
                <div class="w-10 h-10 rounded-2xl bg-emerald-600/20 border border-emerald-500/30 text-emerald-400 flex items-center justify-center shadow-md">
                  <i data-lucide="upload-cloud" class="w-5 h-5"></i>
                </div>
                <div>
                  <h3 class="text-base font-bold text-white">
                    <%= submission && submission.status === 'rejected' ? 'Kirim Ulang Revisi Tugas Akhir' : 'Formulir Pengumpulan Tugas Akhir' %>
                  </h3>
                  <p class="text-xs text-slate-400 mt-0.5">Unggah file hasil karyamu atau tuliskan link demo/repository</p>
                </div>
              </div>
            </div>

            <form action="/course/<%= course.slug %>/final-project" method="POST" enctype="multipart/form-data" class="space-y-6">
              
              <!-- File Upload Zone -->
              <div>
                <label class="block text-xs font-bold text-slate-300 mb-2 flex items-center gap-1.5">
                  <i data-lucide="file-up" class="w-4 h-4 text-indigo-400"></i> Berkas Tugas (ZIP / RAR / PDF / Dokumen)
                  <span class="text-[10px] text-slate-500 font-normal ml-auto">Maks. 50 MB</span>
                </label>
                
                <div class="relative group border-2 border-dashed border-slate-800 hover:border-indigo-500/50 rounded-2xl p-6 bg-slate-950/50 hover:bg-slate-950 transition-all text-center">
                  <input type="file" name="submission_file" id="submission_file" class="absolute inset-0 w-full h-full opacity-0 cursor-pointer z-10" onchange="updateFileName(this)">
                  <div class="space-y-2">
                    <div class="w-12 h-12 rounded-2xl bg-indigo-600/10 group-hover:bg-indigo-600/20 text-indigo-400 flex items-center justify-center mx-auto transition-colors">
                      <i data-lucide="cloud-upload" class="w-6 h-6"></i>
                    </div>
                    <div class="text-xs font-semibold text-slate-200" id="file-label-text">
                      Klik atau seret file tugas ke sini untuk upload
                    </div>
                    <p class="text-[11px] text-slate-500">Mendukung format .zip, .rar, .pdf, .docx, .png</p>
                  </div>
                </div>
              </div>

              <!-- Notes & Links Textarea -->
              <div>
                <label class="block text-xs font-bold text-slate-300 mb-2 flex items-center gap-1.5">
                  <i data-lucide="link" class="w-4 h-4 text-indigo-400"></i> Catatan, Link Repository, atau Demo Proyek
                </label>
                <div class="relative">
                  <textarea 
                    name="text_content" 
                    rows="6" 
                    placeholder="Tuliskan keterangan tugasmu di sini... Contoh:
- Link GitHub: https://github.com/username/project
- Live Demo: https://myproject.vercel.app
- Catatan tambahan mengenai implementasi..."
                    class="w-full px-4 py-3 bg-slate-950 border border-slate-800 rounded-2xl text-xs text-slate-100 placeholder-slate-500 font-mono focus:outline-none focus:border-indigo-500 focus:ring-1 focus:ring-indigo-500 transition-all leading-relaxed"></textarea>
                </div>
                <p class="text-[11px] text-slate-500 mt-1.5">
                  💡 Kamu dapat mengisi link saja, upload file saja, atau mengisi keduanya secara bersamaan.
                </p>
              </div>

              <!-- Submit Button -->
              <button type="submit" class="w-full py-4 bg-gradient-to-r from-indigo-600 via-indigo-500 to-violet-600 hover:from-indigo-500 hover:to-violet-500 text-white font-extrabold rounded-2xl text-xs sm:text-sm shadow-xl shadow-indigo-600/25 hover:shadow-indigo-600/40 transition-all flex items-center justify-center gap-2 hover:scale-[1.01]">
                <i data-lucide="send" class="w-4 h-4"></i>
                <span><%= submission && submission.status === 'rejected' ? 'Kirim Ulang Revisi Tugas Akhir' : 'Kirim Tugas Akhir Sekarang' %></span>
              </button>

            </form>
          </div>
        <% } %>

      </div>

      <!-- Right Column (1 Col): Certificate Showcase Preview & Criteria -->
      <div class="space-y-6">
        
        <!-- Certificate Preview Card -->
        <div class="bg-gradient-to-b from-slate-900 via-slate-900 to-indigo-950/30 border border-slate-800 rounded-3xl p-6 shadow-xl relative overflow-hidden">
          <div class="w-12 h-12 rounded-2xl bg-amber-500/10 border border-amber-500/20 text-amber-400 flex items-center justify-center mb-4 shadow-lg shadow-amber-500/10">
            <i data-lucide="award" class="w-6 h-6"></i>
          </div>

          <h3 class="text-base font-extrabold text-white">Sertifikat Kelulusan Resmi</h3>
          <p class="text-xs text-slate-400 mt-1 leading-relaxed">
            Dapatkan sertifikat digital berstandar industri dengan kode unik terverifikasi dan barcode resmi setelah tugas akhir kamu dinyatakan lulus oleh tim penilai.
          </p>

          <!-- Certificate Perks -->
          <div class="mt-6 pt-5 border-t border-slate-800/80 space-y-3 text-xs text-slate-300">
            <div class="flex items-center gap-2.5">
              <div class="w-5 h-5 rounded-full bg-emerald-500/20 text-emerald-400 flex items-center justify-center shrink-0">
                <i data-lucide="check" class="w-3 h-3"></i>
              </div>
              <span>ID & Barcode Verifikasi Unik</span>
            </div>
            <div class="flex items-center gap-2.5">
              <div class="w-5 h-5 rounded-full bg-emerald-500/20 text-emerald-400 flex items-center justify-center shrink-0">
                <i data-lucide="check" class="w-3 h-3"></i>
              </div>
              <span>Export High-Res PNG & Cetak PDF</span>
            </div>
            <div class="flex items-center gap-2.5">
              <div class="w-5 h-5 rounded-full bg-emerald-500/20 text-emerald-400 flex items-center justify-center shrink-0">
                <i data-lucide="check" class="w-3 h-3"></i>
              </div>
              <span>Dapat dilampirkan di CV & LinkedIn</span>
            </div>
          </div>

          <!-- Mock Certificate Mini Card -->
          <div class="mt-6 p-4 rounded-2xl bg-slate-950 border border-amber-500/20 relative group hover:border-amber-500/40 transition-all">
            <div class="flex items-center justify-between mb-2">
              <span class="text-[9px] font-bold text-amber-400 uppercase tracking-widest">Certificate Preview</span>
              <i data-lucide="shield-check" class="w-3.5 h-3.5 text-amber-400"></i>
            </div>
            <div class="text-[11px] font-bold text-white truncate"><%= course.title %></div>
            <div class="text-[10px] text-slate-400 mt-0.5">Diberikan kepada siswa berprestasi</div>
          </div>
        </div>

        <!-- Review Guidelines & FAQ Box -->
        <div class="bg-slate-900 border border-slate-800 rounded-3xl p-6 shadow-xl space-y-4">
          <h4 class="text-xs font-bold text-slate-200 uppercase tracking-wider flex items-center gap-2">
            <i data-lucide="help-circle" class="w-4 h-4 text-indigo-400"></i> Tips & Ketentuan Review
          </h4>

          <div class="space-y-3 text-xs text-slate-400 leading-relaxed">
            <div class="p-3 bg-slate-950/60 rounded-xl border border-slate-800/80">
              <strong class="text-slate-200 block mb-1">⏱️ Berapa lama review tugas?</strong>
              Proses evaluasi oleh instruktur biasanya memakan waktu maksimal 1x24 jam kerja.
            </div>
            <div class="p-3 bg-slate-950/60 rounded-xl border border-slate-800/80">
              <strong class="text-slate-200 block mb-1">🔄 Bagaimana jika tugas perlu revisi?</strong>
              Jangan khawatir, kamu bisa membaca catatan instruktur lalu mengirimkan kembali tugas perbaikan tanpa biaya tambahan.
            </div>
          </div>
        </div>

      </div>

    </div>

  </div>
</div>

<script>
  function updateFileName(input) {
    const label = document.getElementById('file-label-text');
    if (input.files && input.files[0]) {
      label.innerHTML = '<span class="text-emerald-400 font-bold flex items-center justify-center gap-1.5"><i data-lucide="check" class="w-4 h-4"></i> ' + input.files[0].name + ' (' + (input.files[0].size / (1024 * 1024)).toFixed(2) + ' MB)</span>';
      if (window.lucide && typeof window.lucide.createIcons === 'function') {
        window.lucide.createIcons();
      }
    }
  }
</script>
