<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-6">
  <!-- Top Bar: Back, Course Title, Final Project Link & Progress Bar -->
  <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-4 pb-6 mb-6 border-b border-slate-800">
    <div class="flex items-center gap-3">
      <a href="/my-courses" class="p-2 rounded-xl bg-slate-900 border border-slate-800 text-slate-400 hover:text-white transition-colors flex items-center gap-1 text-xs font-semibold" title="Keluar dari Ruang Belajar (Kembali ke Kelas Saya)">
        
        <span class="hidden sm:inline">Kembali</span>
      </a>
      <div class="h-6 w-px bg-slate-800 mx-1 hidden sm:block"></div>
      <div>
        <h1 class="text-base sm:text-lg font-bold text-white"><%= course.title %></h1>
        <p class="text-xs text-slate-400">Sedang mempelajari: <strong class="text-indigo-400"><%= activeLesson.title %></strong></p>
      </div>
    </div>

    <!-- Actions & Progress indicator -->
    <div class="flex flex-wrap items-center gap-3">
      <% if (isEnrolled) { %>
        <!-- Button Tugas Akhir / Sertifikat -->
        <% if (submission && submission.status === 'approved') { %>
          <a href="/certificate/<%= submission.certificate_code %>" class="px-3.5 py-2 rounded-xl text-xs font-bold bg-amber-500/10 hover:bg-amber-500/20 text-amber-300 border border-amber-500/30 flex items-center gap-1.5 transition-all">
            <i data-lucide="award" class="w-4 h-4 text-amber-400"></i> Lihat Sertifikat
          </a>
        <% } else { %>
          <a href="/course/<%= course.slug %>/final-project" class="px-3.5 py-2 rounded-xl text-xs font-bold bg-indigo-600/20 hover:bg-indigo-600/30 text-indigo-300 border border-indigo-500/30 flex items-center gap-1.5 transition-all">
            <i data-lucide="file-check" class="w-4 h-4"></i> <%= submission ? (submission.status === 'rejected' ? 'Revisi Tugas Akhir' : 'Status Tugas Akhir') : 'Kumpulkan Tugas Akhir' %>
          </a>
        <% } %>

        <button id="btn-toggle-progress" data-lesson-id="<%= activeLesson.id %>" class="px-3.5 py-2 rounded-xl text-xs font-semibold flex items-center gap-1.5 transition-all <%= completedLessonIds.has(activeLesson.id) ? 'bg-emerald-500/20 text-emerald-300 border border-emerald-500/40' : 'bg-slate-800 hover:bg-slate-700 text-slate-200 border border-slate-700' %>">
          <i data-lucide="<%= completedLessonIds.has(activeLesson.id) ? 'circle-check' : 'circle' %>" class="w-4 h-4"></i>
          <span id="btn-progress-label"><%= completedLessonIds.has(activeLesson.id) ? 'Selesai Dipelajari' : 'Tandai Selesai' %></span>
        </button>
      <% } %>
    </div>
  </div>

  <!-- Classroom Grid Layout -->
  <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
    
    <!-- Left 2 Cols: Main Player & Content (Video / Teks Artikel) -->
    <div class="lg:col-span-2 space-y-6">
      
      <% if (!canAccess) { %>
        <!-- LOCKED CONTENT OVERLAY -->
        <div class="aspect-video bg-slate-900 border border-slate-800 rounded-2xl flex flex-col items-center justify-center p-8 text-center shadow-2xl relative overflow-hidden">
          <div class="w-16 h-16 rounded-2xl bg-amber-500/10 text-amber-400 flex items-center justify-center mb-4 border border-amber-500/20 shadow-lg shadow-amber-500/10">
            <i data-lucide="lock" class="w-8 h-8"></i>
          </div>
          <h2 class="text-xl font-bold text-white mb-2">Materi Terkunci 🔒</h2>
          <p class="text-xs text-slate-400 max-w-md mb-6 leading-relaxed">
            Materi ini adalah bagian dari kurikulum premium. Dapatkan akses penuh ke seluruh modul, artikel, video, tugas akhir, dan sertifikat dengan membeli kelas ini.
          </p>
          <div class="flex items-center gap-3">
            <a href="/orders/checkout?courseId=<%= course.id %>" class="px-6 py-2.5 bg-indigo-600 hover:bg-indigo-500 text-white text-xs font-bold rounded-xl shadow-lg shadow-indigo-600/25 transition-all flex items-center gap-2">
              <i data-lucide="shopping-cart" class="w-4 h-4"></i> Beli Kelas Sekarang (Rp <%= Number(course.price).toLocaleString('id-ID') %>)
            </a>
          </div>
        </div>
      <% } else { %>
        
        <!-- VIDEO PLAYER (Hanya jika tipe video) -->
        <% if (activeLesson.content_type === 'video') { %>
          <div class="aspect-video bg-black rounded-2xl overflow-hidden border border-slate-800 shadow-2xl relative mb-6">
            <% if (activeLesson.video_url && activeLesson.video_url.includes('youtube')) { %>
              <iframe class="w-full h-full" src="<%= activeLesson.video_url %>" title="<%= activeLesson.title %>" frameborder="0" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" allowfullscreen></iframe>
            <% } else if (activeLesson.video_url) { %>
              <video src="<%= activeLesson.video_url %>" controls class="w-full h-full object-contain"></video>
            <% } else { %>
              <div class="w-full h-full flex flex-col items-center justify-center text-slate-500">
                <i data-lucide="video-off" class="w-10 h-10 mb-2"></i>
                <span class="text-xs">Link video belum diisi.</span>
              </div>
            <% } %>
          </div>
        <% } %>

        <!-- ARTIKEL / TEKS MATERI (Rich Markdown Render) -->
        <div class="bg-slate-900 border border-slate-800 rounded-2xl p-6 sm:p-8 shadow-xl">
          <div class="flex items-center justify-between pb-4 mb-6 border-b border-slate-800">
            <div class="flex items-center gap-3">
              <div class="w-10 h-10 rounded-xl <%= activeLesson.content_type === 'video' ? 'bg-indigo-600/20 text-indigo-400' : 'bg-amber-500/20 text-amber-400' %> flex items-center justify-center">
                <i data-lucide="<%= activeLesson.content_type === 'video' ? 'circle-play' : 'file-text' %>" class="w-5 h-5"></i>
              </div>
              <div>
                <span class="text-[10px] font-bold text-slate-400 uppercase tracking-wider block">
                  <%= activeLesson.content_type === 'video' ? 'Video Pembelajaran' : 'Materi Bacaan / Teks' %>
                </span>
                <h2 class="text-lg sm:text-xl font-bold text-white"><%= activeLesson.title %></h2>
              </div>
            </div>

            <div class="flex items-center gap-2">
              <% if (activeLesson.is_preview === 1) { %>
                <span class="px-3 py-1 rounded-full text-xs font-bold bg-emerald-500/10 text-emerald-400 border border-emerald-500/20 flex items-center gap-1.5">
                  <i data-lucide="lock-open" class="w-3.5 h-3.5"></i> Free Preview
                </span>
              <% } %>
              <% if (currentUser && currentUser.role === 'admin') { %>
                <a href="/admin/courses/<%= course.id %>/lessons/<%= activeLesson.id %>/edit" class="p-2 bg-slate-800 hover:bg-slate-700 text-slate-300 rounded-xl text-xs flex items-center gap-1 border border-slate-700 transition-colors" title="Edit Materi Ini">
                  <i data-lucide="pencil" class="w-3.5 h-3.5 text-indigo-400"></i> Edit Materi
                </a>
              <% } %>
            </div>
          </div>

          <!-- RENDER KONTEN TEKS / MARKDOWN -->
          <div class="article-content max-w-none">
            <% if (renderedContentHtml) { %>
              <%- renderedContentHtml %>
            <% } else { %>
              <p class="text-slate-500 italic">Tidak ada isi artikel tambahan untuk materi ini.</p>
            <% } %>
          </div>

          <!-- BOTTOM NAVIGATION: PREVIOUS & NEXT LESSON BUTTONS -->
          <div class="mt-10 pt-6 border-t border-slate-800 flex flex-col sm:flex-row items-stretch sm:items-center justify-between gap-4">
            
            <!-- Previous Button -->
            <% if (prevLesson) { %>
              <a href="/course/<%= course.slug %>/learn?lesson=<%= prevLesson.id %>" class="flex-1 min-w-0 group flex items-center gap-3 p-3.5 rounded-2xl bg-slate-950/60 hover:bg-slate-800/80 border border-slate-800 hover:border-indigo-500/30 transition-all text-left">
                <div class="w-9 h-9 rounded-xl bg-slate-800 group-hover:bg-indigo-600/20 text-slate-400 group-hover:text-indigo-400 flex items-center justify-center shrink-0 transition-colors">
                  <i data-lucide="arrow-left" class="w-4 h-4 group-hover:-translate-x-0.5 transition-transform"></i>
                </div>
                <!-- Tambahkan flex-1 di sini -->
                <div class="min-w-0 flex-1">
                  <span class="text-[10px] font-bold text-slate-500 uppercase tracking-wider block">Sebelumnya</span>
                  <span class="text-xs font-semibold text-slate-200 group-hover:text-indigo-300 truncate block transition-colors"><%= prevLesson.title %></span>
                </div>
              </a>
            <% } else { %>
              <div class="flex-1 min-w-0 opacity-40 p-3.5 rounded-2xl bg-slate-950/20 border border-slate-800/50 flex items-center gap-3 cursor-not-allowed">
                <div class="w-9 h-9 rounded-xl bg-slate-900 text-slate-600 flex items-center justify-center shrink-0">
                  <i data-lucide="arrow-left" class="w-4 h-4"></i>
                </div>
                <div class="min-w-0 flex-1">
                  <span class="text-[10px] font-bold text-slate-600 uppercase tracking-wider block">Sebelumnya</span>
                  <span class="text-xs text-slate-600 truncate block">Awal Materi Kelas</span>
                </div>
              </div>
            <% } %>

            <!-- Next Button / Final Project Link -->
            <% if (nextLesson) { %>
              <!-- Tambahkan min-w-0 pada tag <a> -->
              <a href="/course/<%= course.slug %>/learn?lesson=<%= nextLesson.id %>" class="flex-1 min-w-0 group flex items-center justify-end gap-3 p-3.5 rounded-2xl bg-slate-950/60 hover:bg-slate-800/80 border border-slate-800 hover:border-indigo-500/30 transition-all text-right">
                <!-- Tambahkan flex-1 di sini -->
                <div class="min-w-0 flex-1">
                  <span class="text-[10px] font-bold text-slate-500 uppercase tracking-wider block">Selanjutnya</span>
                  <span class="text-xs font-semibold text-slate-200 group-hover:text-indigo-300 truncate block transition-colors"><%= nextLesson.title %></span>
                </div>
                <div class="w-9 h-9 rounded-xl bg-slate-800 group-hover:bg-indigo-600/20 text-slate-400 group-hover:text-indigo-400 flex items-center justify-center shrink-0 transition-colors">
                  <i data-lucide="arrow-right" class="w-4 h-4 group-hover:translate-x-0.5 transition-transform"></i>
                </div>
              </a>
            <% } else { %>
              <a href="/course/<%= course.slug %>/final-project" class="flex-1 min-w-0 group flex items-center justify-end gap-3 p-3.5 rounded-2xl bg-gradient-to-r from-indigo-950/60 to-violet-950/60 hover:from-indigo-900/80 hover:to-violet-900/80 border border-indigo-500/40 hover:border-indigo-400 transition-all text-right shadow-lg shadow-indigo-500/10">
                <div class="min-w-0 flex-1">
                  <span class="text-[10px] font-bold text-amber-400 uppercase tracking-wider flex items-center justify-end gap-1">
                    <i data-lucide="sparkles" class="w-3 h-3"></i> Langkah Terakhir
                  </span>
                  <span class="text-xs font-bold text-white group-hover:text-indigo-200 truncate block">Kerjakan Tugas Akhir &rarr;</span>
                </div>
                <div class="w-9 h-9 rounded-xl bg-indigo-600 text-white flex items-center justify-center shrink-0 shadow-md">
                  <i data-lucide="award" class="w-4 h-4"></i>
                </div>
              </a>
            <% } %>
          </div>

        </div>
      <% } %>

    </div>

    <!-- Right 1 Col: Interactive Modul Tree Navigation -->
    <div>
      <div class="bg-slate-900 border border-slate-800 rounded-2xl p-5 shadow-xl sticky top-24 space-y-4">
        
        <!-- Tugas Akhir Banner in Sidebar -->
        <% if (isEnrolled) { %>
          <div class="p-3.5 bg-gradient-to-r from-indigo-950 to-slate-900 border border-indigo-500/30 rounded-xl">
            <div class="flex items-center justify-between mb-1.5">
              <span class="text-[11px] font-bold text-indigo-300 flex items-center gap-1">
                <i data-lucide="award" class="w-3.5 h-3.5 text-amber-400"></i> Proyek Kelulusan
              </span>
              <% if (submission && submission.status === 'approved') { %>
                <span class="text-[9px] font-bold text-emerald-400 bg-emerald-500/10 px-1.5 py-0.5 rounded">Lulus 🏆</span>
              <% } else if (submission && submission.status === 'pending') { %>
                <span class="text-[9px] font-bold text-amber-400 bg-amber-500/10 px-1.5 py-0.5 rounded">Di-review ⏳</span>
              <% } else if (submission && submission.status === 'rejected') { %>
                <span class="text-[9px] font-bold text-rose-400 bg-rose-500/10 px-1.5 py-0.5 rounded">Revisi ⚠️</span>
              <% } %>
            </div>
            <a href="/course/<%= course.slug %>/final-project" class="text-xs font-semibold text-white hover:text-indigo-400 flex items-center justify-between group transition-colors">
              <span><%= course.final_project_title || 'Tugas Akhir' %></span>
              <i data-lucide="chevron-right" class="w-3.5 h-3.5 group-hover:translate-x-0.5 transition-transform"></i>
            </a>
          </div>
        <% } %>

        <div class="flex items-center justify-between pb-2 border-b border-slate-800">
          <h3 class="text-sm font-bold text-white flex items-center gap-2">
            <i data-lucide="folder-tree" class="w-4 h-4 text-indigo-400"></i> Daftar Modul
          </h3>
          <span class="text-xs text-slate-500 font-medium">Tree View</span>
        </div>

        <div class="space-y-3 max-h-[calc(100vh-280px)] overflow-y-auto pr-1">
          <% moduleTree.forEach((m, mIdx) => { %>
            <div class="border border-slate-800/80 rounded-xl bg-slate-950/60 overflow-hidden">
              <div class="px-3 py-2.5 bg-slate-800/30 border-b border-slate-800/50 flex items-center justify-between text-xs font-bold text-slate-300">
                <span class="flex items-center gap-2 truncate">
                  <span class="text-indigo-400 font-mono"><%= mIdx + 1 %>.</span> <%= m.title %>
                </span>
              </div>

              <div class="p-1.5 space-y-1">
                <% m.lessons.forEach(l => { %>
                  <% 
                    const isActive = l.id === activeLesson.id;
                    const isUnlocked = isEnrolled || l.is_preview === 1 || (currentUser && currentUser.role === 'admin');
                  %>
                  <a href="/course/<%= course.slug %>/learn?lesson=<%= l.id %>" class="flex items-center justify-between px-3 py-2 rounded-lg text-xs transition-all <%= isActive ? 'bg-indigo-600 text-white font-semibold shadow-md shadow-indigo-600/20' : 'hover:bg-slate-800/60 text-slate-300' %>">
                    <div class="flex items-center gap-2.5 truncate">
                      <i data-lucide="<%= l.is_completed ? 'circle-check' : (l.content_type === 'video' ? 'circle-play' : 'file-text') %>" class="w-3.5 h-3.5 shrink-0 <%= l.is_completed ? (isActive ? 'text-white' : 'text-emerald-400') : (isActive ? 'text-white' : (l.content_type === 'video' ? 'text-indigo-400' : 'text-amber-400')) %>"></i>
                      <span class="truncate"><%= l.title %></span>
                    </div>

                    <div class="shrink-0 ml-2">
                      <% if (!isUnlocked) { %>
                        <i data-lucide="lock" class="w-3 h-3 text-slate-500"></i>
                      <% } else if (l.is_preview === 1 && !isEnrolled) { %>
                        <span class="text-[9px] font-bold px-1.5 py-0.5 rounded bg-emerald-500/20 text-emerald-300">Free</span>
                      <% } %>
                    </div>
                  </a>
                <% }) %>

                <!-- Sub-modul tree branch -->
                <% m.submodules.forEach(sub => { %>
                  <div class="ml-4 pl-2 border-l border-indigo-500/30 space-y-1 my-1">
                    <span class="text-[11px] font-semibold text-indigo-300 px-2 py-0.5 block"><%= sub.title %></span>
                    <% sub.lessons.forEach(subL => { %>
                      <% 
                        const isSubActive = subL.id === activeLesson.id;
                        const isSubUnlocked = isEnrolled || subL.is_preview === 1 || (currentUser && currentUser.role === 'admin');
                      %>
                      <a href="/course/<%= course.slug %>/learn?lesson=<%= subL.id %>" class="flex items-center justify-between px-2.5 py-1.5 rounded-lg text-xs transition-all <%= isSubActive ? 'bg-indigo-600 text-white font-semibold' : 'hover:bg-slate-800/60 text-slate-300' %>">
                        <div class="flex items-center gap-2 truncate">
                          <i data-lucide="<%= subL.content_type === 'video' ? 'circle-play' : 'file-text' %>" class="w-3 h-3 text-slate-400 shrink-0"></i>
                          <span class="truncate text-[11px]"><%= subL.title %></span>
                        </div>
                        <% if (!isSubUnlocked) { %>
                          <i data-lucide="lock" class="w-3 h-3 text-slate-500"></i>
                        <% } %>
                      </a>
                    <% }) %>
                  </div>
                <% }) %>
              </div>
            </div>
          <% }) %>
        </div>

      </div>
    </div>

  </div>
</div>

<script>
  const btnToggleProgress = document.getElementById('btn-toggle-progress');
  if (btnToggleProgress) {
    btnToggleProgress.addEventListener('click', async () => {
      const lessonId = btnToggleProgress.getAttribute('data-lesson-id');
      try {
        const res = await fetch('/api/progress/toggle', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ lessonId })
        });
        const data = await res.json();
        if (data.success) {
          window.location.reload();
        }
      } catch (err) {
        console.error('Error toggling progress:', err);
      }
    });
  }
</script>
