<div class="max-w-2xl mx-auto my-12 px-4">
  <div class="bg-slate-900 border border-slate-800 rounded-2xl p-6 sm:p-8 shadow-xl">
    <div class="flex items-center gap-3 pb-6 mb-6 border-b border-slate-800">
      <div class="w-10 h-10 rounded-xl bg-indigo-600/20 text-indigo-400 flex items-center justify-center">
        <i data-lucide="shopping-cart" class="w-5 h-5"></i>
      </div>
      <div>
        <h1 class="text-xl font-bold text-white">Ringkasan Checkout</h1>
        <p class="text-xs text-slate-400">Konfirmasi pendaftaran kelas dan selesaikan pembayaran.</p>
      </div>
    </div>

    <!-- Course Card Info -->
    <div class="flex flex-col sm:flex-row items-center gap-4 bg-slate-950 p-4 rounded-xl border border-slate-800/80 mb-6">
      <div class="w-full sm:w-28 aspect-video bg-slate-900 rounded-lg overflow-hidden shrink-0">
        <% if (course.thumbnail_url) { %>
          <img src="<%= course.thumbnail_url %>" alt="<%= course.title %>" class="w-full h-full object-cover">
        <% } else { %>
          <div class="w-full h-full flex items-center justify-center bg-indigo-950/40 text-indigo-400">
            <i data-lucide="book-open" class="w-6 h-6"></i>
          </div>
        <% } %>
      </div>
      <div class="flex-1 w-full">
        <h3 class="font-bold text-sm text-white"><%= course.title %></h3>
        <p class="text-xs text-slate-400 mt-1 line-clamp-1"><%= course.description || 'Akses seumur hidup ke semua modul dan materi.' %></p>
      </div>
      <div class="text-right shrink-0 w-full sm:w-auto">
        <span class="text-[10px] text-slate-500 uppercase font-semibold block">Total Biaya</span>
        <span class="text-base font-extrabold text-white">
          <%= course.price === 0 ? 'GRATIS' : 'Rp ' + Number(course.price).toLocaleString('id-ID') %>
        </span>
      </div>
    </div>

    <!-- Summary Details -->
    <div class="space-y-3 border-t border-slate-800 pt-4 mb-6 text-xs text-slate-300">
      <div class="flex justify-between">
        <span>Harga Kursus</span>
        <span class="font-semibold text-white">Rp <%= Number(course.price).toLocaleString('id-ID') %></span>
      </div>
      <div class="flex justify-between">
        <span>Biaya Layanan & Pajak</span>
        <span class="font-semibold text-emerald-400">Rp 0 (Gratis)</span>
      </div>
      <div class="flex justify-between pt-3 border-t border-slate-800 text-sm font-bold text-white">
        <span>Total Pembayaran</span>
        <span class="text-indigo-400">Rp <%= Number(course.price).toLocaleString('id-ID') %></span>
      </div>
    </div>

    <form action="/orders/checkout" method="POST">
      <input type="hidden" name="course_id" value="<%= course.id %>">
      <button type="submit" class="w-full py-3.5 bg-indigo-600 hover:bg-indigo-500 text-white font-bold rounded-xl text-sm shadow-lg shadow-indigo-600/25 transition-all flex items-center justify-center gap-2">
        <i data-lucide="credit-card" class="w-4 h-4"></i> <%= course.price === 0 ? 'Daftar Sekarang (Gratis)' : 'Lanjut ke Pembayaran' %>
      </button>
    </form>
  </div>
</div>
