<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
  <div class="flex items-center justify-between mb-8">
    <div>
      <h1 class="text-2xl font-extrabold text-white tracking-tight">Manajemen Kelas</h1>
      <p class="text-xs text-slate-400 mt-1">Daftar semua kelas, atur harga, publikasi, dan susun modul tree.</p>
    </div>
    <a href="/admin/courses/create" class="inline-flex items-center gap-2 px-4 py-2.5 bg-indigo-600 hover:bg-indigo-500 text-white text-xs font-semibold rounded-xl shadow-lg shadow-indigo-600/25 transition-all">
      <i data-lucide="circle-plus" class="w-4 h-4"></i> Tambah Kelas Baru
    </a>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
    <% if (courses.length === 0) { %>
      <div class="col-span-full bg-slate-900 border border-slate-800 rounded-2xl p-12 text-center">
        <i data-lucide="folder-open" class="w-12 h-12 text-slate-600 mx-auto mb-3"></i>
        <h3 class="text-base font-semibold text-slate-200">Belum Ada Kelas</h3>
        <p class="text-xs text-slate-400 mt-1 mb-6">Mulai buat kelas pertama dan susun kurikulum materi belajarnya.</p>
        <a href="/admin/courses/create" class="inline-flex items-center gap-2 px-4 py-2 bg-indigo-600 hover:bg-indigo-500 text-white text-xs font-semibold rounded-xl">
          <i data-lucide="plus" class="w-4 h-4"></i> Buat Kelas Sekarang
        </a>
      </div>
    <% } %>

    <% courses.forEach(c => { %>
      <div class="bg-slate-900 border border-slate-800 rounded-2xl overflow-hidden flex flex-col hover:border-slate-700 transition-all">
        <div class="aspect-video bg-slate-950 relative overflow-hidden">
          <% if (c.thumbnail_url) { %>
            <img src="<%= c.thumbnail_url %>" alt="<%= c.title %>" class="w-full h-full object-cover">
          <% } else { %>
            <div class="w-full h-full flex items-center justify-center bg-gradient-to-tr from-slate-900 to-indigo-950 text-indigo-400">
              <i data-lucide="graduation-cap" class="w-10 h-10 opacity-60"></i>
            </div>
          <% } %>
          <div class="absolute top-3 right-3">
            <% if (c.is_published) { %>
              <span class="px-2.5 py-1 rounded-lg text-[10px] font-bold bg-emerald-500/80 backdrop-blur-md text-white">PUBLISH</span>
            <% } else { %>
              <span class="px-2.5 py-1 rounded-lg text-[10px] font-bold bg-slate-700/80 backdrop-blur-md text-slate-300">DRAFT</span>
            <% } %>
          </div>
        </div>

        <div class="p-5 flex-1 flex flex-col">
          <div class="flex items-center gap-2 mb-2">
            <span class="text-xs font-bold text-indigo-400">
              <%= c.price === 0 ? 'GRATIS' : 'Rp ' + Number(c.price).toLocaleString('id-ID') %>
            </span>
            <span class="text-slate-600">•</span>
            <span class="text-[11px] text-slate-400 flex items-center gap-1">
              <i data-lucide="folder-tree" class="w-3 h-3"></i> <%= c.total_modules %> Modul
            </span>
            <span class="text-slate-600">•</span>
            <span class="text-[11px] text-slate-400 flex items-center gap-1">
              <i data-lucide="users" class="w-3 h-3"></i> <%= c.total_students %> Siswa
            </span>
          </div>

          <h3 class="font-bold text-white text-base leading-snug mb-2 line-clamp-1"><%= c.title %></h3>
          <p class="text-xs text-slate-400 line-clamp-2 mb-4 flex-1"><%= c.description || 'Tidak ada deskripsi.' %></p>

          <div class="pt-4 border-t border-slate-800 flex items-center justify-between gap-2">
            <a href="/admin/courses/<%= c.id %>/modules" class="flex-1 py-2 px-3 bg-indigo-600/20 hover:bg-indigo-600/30 text-indigo-300 hover:text-indigo-200 border border-indigo-500/30 rounded-xl text-xs font-semibold text-center flex items-center justify-center gap-1.5 transition-colors">
              <i data-lucide="network" class="w-3.5 h-3.5"></i> Modul Tree
            </a>
            <a href="/admin/courses/<%= c.id %>/edit" class="p-2 bg-slate-800 hover:bg-slate-700 text-slate-300 rounded-xl text-xs transition-colors" title="Edit Kelas">
              <i data-lucide="pencil" class="w-4 h-4"></i>
            </a>
            <form action="/admin/courses/<%= c.id %>/delete" method="POST" onsubmit="return confirm('Hapus kelas ini beserta semua modulnya?')">
              <button type="submit" class="p-2 bg-rose-500/10 hover:bg-rose-500/20 text-rose-400 rounded-xl text-xs border border-rose-500/20 transition-colors" title="Hapus Kelas">
                <i data-lucide="trash" class="w-4 h-4"></i>
              </button>
            </form>
          </div>
        </div>
      </div>
    <% }) %>
  </div>
</div>
