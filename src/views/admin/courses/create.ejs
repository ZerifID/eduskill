<div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
  <div class="mb-6 flex items-center justify-between">
    <div>
      <h1 class="text-2xl font-extrabold text-white tracking-tight">Tambah Kelas Baru</h1>
      <p class="text-xs text-slate-400 mt-1">Buat judul kelas, tentukan harga, upload thumbnail, atur instruksi tugas akhir, dan publikasikan.</p>
    </div>
    <a href="/admin/courses" class="inline-flex items-center gap-1.5 text-xs text-slate-400 hover:text-white transition-colors">
      <i data-lucide="arrow-left" class="w-4 h-4"></i> Kembali
    </a>
  </div>

  <div class="bg-slate-900 border border-slate-800 rounded-2xl p-6 sm:p-8 shadow-xl">
    <form action="/admin/courses/create" method="POST" enctype="multipart/form-data" class="space-y-6">
      
      <!-- Section 1: Info Kelas -->
      <div class="space-y-4">
        <h3 class="text-xs font-bold text-indigo-400 uppercase tracking-wider flex items-center gap-1.5 pb-2 border-b border-slate-800">
          <i data-lucide="info" class="w-4 h-4"></i> 1. Informasi Dasar Kelas
        </h3>

        <div>
          <label class="block text-xs font-semibold text-slate-300 mb-1.5">Judul Kelas *</label>
          <input type="text" name="title" required placeholder="Contoh: Master Fullstack Node.js & Database Architect" class="w-full px-4 py-2.5 bg-slate-950 border border-slate-800 rounded-xl text-sm text-slate-100 placeholder-slate-500 focus:outline-none focus:border-indigo-500 transition-colors">
        </div>

        <div>
          <label class="block text-xs font-semibold text-slate-300 mb-1.5">Deskripsi Kelas</label>
          <textarea name="description" rows="3" placeholder="Jelaskan apa yang akan dipelajari siswa di kelas ini..." class="w-full px-4 py-2.5 bg-slate-950 border border-slate-800 rounded-xl text-sm text-slate-100 placeholder-slate-500 focus:outline-none focus:border-indigo-500 transition-colors"></textarea>
        </div>

        <div>
          <label class="block text-xs font-semibold text-slate-300 mb-1.5">Harga Kelas (Rp) *</label>
          <input type="number" name="price" value="0" min="0" step="1000" placeholder="0 untuk kelas gratis" class="w-full px-4 py-2.5 bg-slate-950 border border-slate-800 rounded-xl text-sm text-slate-100 placeholder-slate-500 focus:outline-none focus:border-indigo-500 transition-colors">
          <span class="text-[11px] text-slate-500 mt-1 block">Isi 0 jika kelas ini gratis untuk semua siswa.</span>
        </div>

        <!-- Thumbnail Upload & URL -->
        <div class="p-4 bg-slate-950 rounded-2xl border border-slate-800 space-y-3">
          <label class="block text-xs font-bold text-slate-200 flex items-center gap-1.5">
            <i data-lucide="image" class="w-4 h-4 text-indigo-400"></i> Banner / Thumbnail Gambar Kelas
          </label>
          
          <div class="grid grid-cols-1 md:grid-cols-2 gap-4 items-start">
            <!-- Option A: File Upload -->
            <div>
              <span class="text-[11px] text-slate-400 block mb-1.5 font-medium">Opsi 1: Upload File Gambar (JPG, PNG, WEBP)</span>
              <input type="file" name="thumbnail_file" id="thumbnail_file" accept="image/*" class="w-full text-xs text-slate-400 file:mr-3 file:py-2 file:px-4 file:rounded-xl file:border-0 file:text-xs file:font-semibold file:bg-indigo-600/20 file:text-indigo-300 hover:file:bg-indigo-600/30 file:cursor-pointer border border-slate-800 rounded-xl bg-slate-900 p-1">
            </div>

            <!-- Option B: URL Link -->
            <div>
              <span class="text-[11px] text-slate-400 block mb-1.5 font-medium">Opsi 2: Atau Paste URL Gambar Eksternal</span>
              <input type="url" name="thumbnail_url" id="thumbnail_url" placeholder="https://images.unsplash.com/..." class="w-full px-3 py-2 bg-slate-900 border border-slate-800 rounded-xl text-xs text-slate-100 placeholder-slate-600 focus:outline-none focus:border-indigo-500">
            </div>
          </div>

          <!-- Preview Box -->
          <div id="thumb_preview_box" class="hidden mt-3 p-2 bg-slate-900 border border-slate-800 rounded-xl flex items-center gap-3">
            <div class="w-20 h-12 bg-slate-950 rounded-lg overflow-hidden border border-slate-800 shrink-0">
              <img id="thumb_preview_img" src="" alt="Preview" class="w-full h-full object-cover">
            </div>
            <span class="text-[11px] text-emerald-400 font-medium flex items-center gap-1">
              <i data-lucide="check" class="w-3.5 h-3.5"></i> Preview Thumbnail Terpilih
            </span>
          </div>
        </div>

      </div>

      <!-- Section 2: Pengaturan Tugas Akhir -->
      <div class="space-y-4 pt-2">
        <h3 class="text-xs font-bold text-amber-400 uppercase tracking-wider flex items-center gap-1.5 pb-2 border-b border-slate-800">
          <i data-lucide="award" class="w-4 h-4"></i> 2. Pengaturan Tugas Akhir & Syarat Sertifikat
        </h3>

        <div>
          <label class="block text-xs font-semibold text-slate-300 mb-1.5">Judul Tugas Akhir *</label>
          <input type="text" name="final_project_title" value="Proyek Tugas Akhir" placeholder="Contoh: Proyek Akhir: Membuat REST API & Deployment" class="w-full px-4 py-2.5 bg-slate-950 border border-slate-800 rounded-xl text-sm text-slate-100 placeholder-slate-500 focus:outline-none focus:border-indigo-500 transition-colors">
        </div>

        <div>
          <div class="flex items-center justify-between mb-1.5">
            <label class="block text-xs font-semibold text-slate-300 flex items-center gap-1.5">
              <i data-lucide="file-text" class="w-4 h-4 text-indigo-400"></i> Deskripsi & Instruksi Tugas Akhir (Mendukung Markdown)
            </label>
            <div class="flex items-center gap-2">
              <label for="instructions_image_upload" class="cursor-pointer px-2.5 py-1 bg-indigo-600/20 hover:bg-indigo-600/30 text-indigo-300 border border-indigo-500/30 rounded-lg text-[11px] font-semibold flex items-center gap-1.5 transition-colors">
                <i data-lucide="image" class="w-3.5 h-3.5"></i> + Upload Gambar
              </label>
              <input type="file" id="instructions_image_upload" accept="image/*" class="hidden">
              <span class="text-[11px] text-amber-400/90 font-medium hidden sm:inline-block">💡 Bisa Paste (Ctrl+V) Gambar Langsung</span>
            </div>
          </div>

          <div class="relative">
            <textarea id="final_project_instructions_editor" name="final_project_instructions" rows="6" placeholder="Tuliskan instruksi tugas akhir secara detail di sini...&#10;&#10;✨ TIPS: Mendukung format Markdown (Heading, List, Code, dll) dan bisa langsung tekan Ctrl + V (Paste) gambar screenshot/foto apa saja di kotak ini, tag markdown ![](url) bakal otomatis nempel!" class="w-full px-4 py-3 bg-slate-950 border border-slate-800 rounded-xl text-xs text-slate-100 font-mono focus:outline-none focus:border-indigo-500 leading-relaxed"></textarea>
            
            <!-- Uploading Overlay / Indicator -->
            <div id="instructions_upload_indicator" class="hidden absolute bottom-3 right-3 px-3 py-1.5 bg-indigo-600/90 backdrop-blur-md text-white rounded-lg text-[11px] font-semibold flex items-center gap-2 shadow-lg animate-pulse">
              <span class="animate-spin">⏳</span> Mengupload gambar...
            </div>
          </div>
          <p class="text-[11px] text-slate-500 mt-1.5">Format didukung: Heading (`#`), Bold (`**`), List, Blockquote, Kode program, dan Gambar Markdown (`![caption](/url)`).</p>
        </div>
      </div>

      <div class="pt-2">
        <label class="flex items-center gap-3 cursor-pointer select-none">
          <input type="checkbox" name="is_published" value="1" checked class="w-4 h-4 rounded border-slate-800 text-indigo-600 focus:ring-indigo-500 bg-slate-950">
          <span class="text-xs font-medium text-slate-200">Langsung publikasikan kelas ke katalog</span>
        </label>
      </div>

      <div class="pt-4 border-t border-slate-800 flex items-center justify-end gap-3">
        <a href="/admin/courses" class="px-5 py-2.5 text-xs font-semibold text-slate-400 hover:text-white transition-colors">Batal</a>
        <button type="submit" class="px-6 py-2.5 bg-indigo-600 hover:bg-indigo-500 text-white font-semibold rounded-xl text-xs shadow-lg shadow-indigo-600/25 transition-all flex items-center gap-2">
          <i data-lucide="check" class="w-4 h-4"></i> Simpan & Susun Modul
        </button>
      </div>
    </form>
  </div>
</div>

<script>
  const fileInput = document.getElementById('thumbnail_file');
  const urlInput = document.getElementById('thumbnail_url');
  const previewBox = document.getElementById('thumb_preview_box');
  const previewImg = document.getElementById('thumb_preview_img');

  if (fileInput) {
    fileInput.addEventListener('change', (e) => {
      const file = e.target.files[0];
      if (file) {
        const reader = new FileReader();
        reader.onload = (ev) => {
          previewImg.src = ev.target.result;
          previewBox.classList.remove('hidden');
        };
        reader.readAsDataURL(file);
      }
    });
  }

  if (urlInput) {
    urlInput.addEventListener('input', (e) => {
      const val = e.target.value.trim();
      if (val) {
        previewImg.src = val;
        previewBox.classList.remove('hidden');
      }
    });
  }

  // Ctrl+V Paste Image & File Upload Handler for Final Project Instructions
  const instructionsTextarea = document.getElementById('final_project_instructions_editor');
  const instructionsImageUpload = document.getElementById('instructions_image_upload');
  const instructionsUploadIndicator = document.getElementById('instructions_upload_indicator');

  async function uploadInstructionsImage(file) {
    if (!file || !file.type.startsWith('image/')) return;

    if (instructionsUploadIndicator) instructionsUploadIndicator.classList.remove('hidden');

    const formData = new FormData();
    formData.append('image', file);

    try {
      const res = await fetch('/admin/api/upload-image', {
        method: 'POST',
        body: formData
      });

      const data = await res.json();
      if (data.success && data.url) {
        insertTextAtCursor(instructionsTextarea, `\n![Gambar](${data.url})\n`);
      } else {
        alert('Gagal upload gambar: ' + (data.message || 'Terjadi kesalahan'));
      }
    } catch (err) {
      alert('Error saat upload gambar: ' + err.message);
    } finally {
      if (instructionsUploadIndicator) instructionsUploadIndicator.classList.add('hidden');
    }
  }

  function insertTextAtCursor(input, textToInsert) {
    const startPos = input.selectionStart;
    const endPos = input.selectionEnd;
    const currentVal = input.value;

    input.value = currentVal.substring(0, startPos) + textToInsert + currentVal.substring(endPos, currentVal.length);
    input.focus();
    input.selectionStart = startPos + textToInsert.length;
    input.selectionEnd = startPos + textToInsert.length;
  }

  // Event: Paste (Ctrl+V)
  if (instructionsTextarea) {
    instructionsTextarea.addEventListener('paste', (e) => {
      const clipboardData = e.clipboardData || window.clipboardData;
      if (!clipboardData) return;

      const items = clipboardData.items;
      for (let i = 0; i < items.length; i++) {
        if (items[i].type.indexOf('image') !== -1) {
          const file = items[i].getAsFile();
          if (file) {
            e.preventDefault();
            uploadInstructionsImage(file);
            break;
          }
        }
      }
    });
  }

  // Event: Button Upload File Image
  if (instructionsImageUpload) {
    instructionsImageUpload.addEventListener('change', (e) => {
      const file = e.target.files[0];
      if (file) {
        uploadInstructionsImage(file);
        instructionsImageUpload.value = '';
      }
    });
  }
</script>
