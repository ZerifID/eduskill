<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
  <!-- Top Bar -->
  <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-4 mb-8">
    <div>
      <h1 class="text-2xl font-extrabold text-white tracking-tight">Admin Dashboard</h1>
      <p class="text-xs text-slate-400 mt-1">Kelola kelas, modul tree freemium, siswa, dan transaksi sistem.</p>
    </div>
    <div class="flex items-center gap-3">
      <a href="/admin/courses/create" class="inline-flex items-center gap-2 px-4 py-2.5 bg-indigo-600 hover:bg-indigo-500 text-white text-xs font-semibold rounded-xl shadow-lg shadow-indigo-600/25 transition-all">
        <i data-lucide="circle-plus" class="w-4 h-4"></i> Tambah Kelas Baru
      </a>
      <a href="/admin/courses" class="inline-flex items-center gap-2 px-4 py-2.5 bg-slate-800 hover:bg-slate-700 text-slate-200 text-xs font-semibold rounded-xl border border-slate-700 transition-colors">
        <i data-lucide="book-open" class="w-4 h-4"></i> Kelola Kelas
      </a>
    </div>
  </div>

  <!-- Stats Grid -->
  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 mb-8">
    <div class="bg-slate-900/90 border border-slate-800 rounded-2xl p-5">
      <div class="flex items-center justify-between text-slate-400 mb-2">
        <span class="text-xs font-medium">Total Siswa</span>
        <div class="w-8 h-8 rounded-lg bg-blue-500/10 text-blue-400 flex items-center justify-center">
          <i data-lucide="users" class="w-4 h-4"></i>
        </div>
      </div>
      <p class="text-2xl font-bold text-white"><%= stats.totalUsers %></p>
    </div>

    <div class="bg-slate-900/90 border border-slate-800 rounded-2xl p-5">
      <div class="flex items-center justify-between text-slate-400 mb-2">
        <span class="text-xs font-medium">Total Kelas</span>
        <div class="w-8 h-8 rounded-lg bg-violet-500/10 text-violet-400 flex items-center justify-center">
          <i data-lucide="graduation-cap" class="w-4 h-4"></i>
        </div>
      </div>
      <p class="text-2xl font-bold text-white"><%= stats.totalCourses %></p>
    </div>

    <div class="bg-slate-900/90 border border-slate-800 rounded-2xl p-5">
      <div class="flex items-center justify-between text-slate-400 mb-2">
        <span class="text-xs font-medium">Total Transaksi</span>
        <div class="w-8 h-8 rounded-lg bg-amber-500/10 text-amber-400 flex items-center justify-center">
          <i data-lucide="shopping-bag" class="w-4 h-4"></i>
        </div>
      </div>
      <p class="text-2xl font-bold text-white"><%= stats.totalOrders %></p>
    </div>

    <div class="bg-slate-900/90 border border-slate-800 rounded-2xl p-5">
      <div class="flex items-center justify-between text-slate-400 mb-2">
        <span class="text-xs font-medium">Pendapatan Masuk</span>
        <div class="w-8 h-8 rounded-lg bg-emerald-500/10 text-emerald-400 flex items-center justify-center">
          <i data-lucide="wallet" class="w-4 h-4"></i>
        </div>
      </div>
      <p class="text-2xl font-bold text-emerald-400">Rp <%= Number(stats.totalRevenue).toLocaleString('id-ID') %></p>
    </div>
  </div>

  <!-- Recent Orders Table -->
  <div class="bg-slate-900 border border-slate-800 rounded-2xl overflow-hidden shadow-xl">
    <div class="px-6 py-4 border-b border-slate-800 flex items-center justify-between">
      <h2 class="text-sm font-bold text-white flex items-center gap-2">
        <i data-lucide="clock" class="w-4 h-4 text-indigo-400"></i> Transaksi Terbaru
      </h2>
      <a href="/admin/orders" class="text-xs text-indigo-400 hover:text-indigo-300 font-medium">Lihat Semua &rarr;</a>
    </div>

    <div class="overflow-x-auto">
      <table class="w-full text-left text-xs text-slate-300">
        <thead class="bg-slate-950/60 text-slate-400 font-semibold border-b border-slate-800">
          <tr>
            <th class="px-6 py-3">Order Code</th>
            <th class="px-6 py-3">Siswa</th>
            <th class="px-6 py-3">Kelas</th>
            <th class="px-6 py-3">Nominal</th>
            <th class="px-6 py-3">Status</th>
            <th class="px-6 py-3">Tanggal</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-800/60">
          <% if (recentOrders.length === 0) { %>
            <tr>
              <td colspan="6" class="px-6 py-8 text-center text-slate-500">Belum ada transaksi masuk.</td>
            </tr>
          <% } %>
          <% recentOrders.forEach(o => { %>
            <tr class="hover:bg-slate-800/30 transition-colors">
              <td class="px-6 py-3.5 font-mono text-indigo-300 font-medium"><%= o.order_code %></td>
              <td class="px-6 py-3.5">
                <div class="font-medium text-slate-200"><%= o.user_name %></div>
                <div class="text-[11px] text-slate-500"><%= o.user_email %></div>
              </td>
              <td class="px-6 py-3.5 text-slate-200"><%= o.course_title %></td>
              <td class="px-6 py-3.5 font-semibold text-slate-100">Rp <%= Number(o.amount).toLocaleString('id-ID') %></td>
              <td class="px-6 py-3.5">
                <% if (o.status === 'paid') { %>
                  <span class="px-2.5 py-1 rounded-full text-[10px] font-semibold bg-emerald-500/10 text-emerald-400 border border-emerald-500/20">LUNAS</span>
                <% } else if (o.status === 'pending') { %>
                  <span class="px-2.5 py-1 rounded-full text-[10px] font-semibold bg-amber-500/10 text-amber-400 border border-amber-500/20">PENDING</span>
                <% } else { %>
                  <span class="px-2.5 py-1 rounded-full text-[10px] font-semibold bg-rose-500/10 text-rose-400 border border-rose-500/20"><%= o.status.toUpperCase() %></span>
                <% } %>
              </td>
              <td class="px-6 py-3.5 text-slate-400 text-[11px]"><%= new Date(o.created_at).toLocaleString('id-ID') %></td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  </div>
</div>
