<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
  <div class="flex items-center justify-between mb-8">
    <div>
      <h1 class="text-2xl font-extrabold text-white tracking-tight">Review Tugas Akhir Siswa</h1>
      <p class="text-xs text-slate-400 mt-1">Evaluasi hasil kerja siswa untuk kelulusan dan penerbitan sertifikat digital.</p>
    </div>
  </div>

  <div class="bg-slate-900 border border-slate-800 rounded-2xl overflow-hidden shadow-xl">
    <div class="overflow-x-auto">
      <table class="w-full text-left text-xs text-slate-300">
        <thead class="bg-slate-950/60 text-slate-400 font-semibold border-b border-slate-800">
          <tr>
            <th class="px-6 py-3.5">Siswa</th>
            <th class="px-6 py-3.5">Kelas</th>
            <th class="px-6 py-3.5">Tipe Submission</th>
            <th class="px-6 py-3.5">Status</th>
            <th class="px-6 py-3.5">Tanggal Kirim</th>
            <th class="px-6 py-3.5 text-right">Aksi</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-800/60">
          <% if (submissions.length === 0) { %>
            <tr>
              <td colspan="6" class="px-6 py-10 text-center text-slate-500">
                <i data-lucide="inbox" class="w-8 h-8 mx-auto mb-2 opacity-50"></i>
                Belum ada pengumpulan tugas akhir dari siswa.
              </td>
            </tr>
          <% } %>
          <% submissions.forEach(s => { %>
            <tr class="hover:bg-slate-800/30 transition-colors">
              <td class="px-6 py-4">
                <div class="font-bold text-slate-100"><%= s.user_name %></div>
                <div class="text-[11px] text-slate-500"><%= s.user_email %></div>
              </td>
              <td class="px-6 py-4 text-slate-200 font-medium"><%= s.course_title %></td>
              <td class="px-6 py-4">
                <div class="flex items-center gap-1.5 text-slate-300">
                  <% if (s.file_url) { %>
                    <span class="px-2 py-0.5 rounded bg-indigo-500/10 text-indigo-300 border border-indigo-500/20 text-[10px] font-semibold flex items-center gap-1">
                      <i data-lucide="paperclip" class="w-3 h-3"></i> File Upload
                    </span>
                  <% } %>
                  <% if (s.text_content) { %>
                    <span class="px-2 py-0.5 rounded bg-amber-500/10 text-amber-300 border border-amber-500/20 text-[10px] font-semibold flex items-center gap-1">
                      <i data-lucide="file-text" class="w-3 h-3"></i> Teks / Link
                    </span>
                  <% } %>
                </div>
              </td>
              <td class="px-6 py-4">
                <% if (s.status === 'approved') { %>
                  <span class="px-2.5 py-1 rounded-full text-[10px] font-bold bg-emerald-500/10 text-emerald-400 border border-emerald-500/20 flex items-center gap-1 w-fit">
                    <i data-lucide="circle-check" class="w-3 h-3"></i> LULUS (APPROVED)
                  </span>
                <% } else if (s.status === 'rejected') { %>
                  <span class="px-2.5 py-1 rounded-full text-[10px] font-bold bg-rose-500/10 text-rose-400 border border-rose-500/20 flex items-center gap-1 w-fit">
                    <i data-lucide="circle-x" class="w-3 h-3"></i> PERLU REVISI (REJECTED)
                  </span>
                <% } else { %>
                  <span class="px-2.5 py-1 rounded-full text-[10px] font-bold bg-amber-500/10 text-amber-400 border border-amber-500/20 flex items-center gap-1 w-fit animate-pulse">
                    <i data-lucide="clock" class="w-3 h-3"></i> MENUNGGU REVIEW
                  </span>
                <% } %>
              </td>
              <td class="px-6 py-4 text-slate-400 text-[11px]"><%= new Date(s.created_at).toLocaleString('id-ID') %></td>
              <td class="px-6 py-4 text-right">
                <a href="/admin/submissions/<%= s.id %>" class="inline-flex items-center gap-1.5 px-3 py-1.5 bg-indigo-600/20 hover:bg-indigo-600 text-indigo-300 hover:text-white border border-indigo-500/30 rounded-xl text-xs font-semibold transition-all">
                  <i data-lucide="eye" class="w-3.5 h-3.5"></i> Review Tugas
                </a>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  </div>
</div>
