<div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
  <div class="mb-6 flex items-center justify-between">
    <div>
      <div class="flex items-center gap-2 text-xs text-indigo-400 font-semibold mb-1">
        <a href="/admin/courses/<%= course.id %>/modules" class="hover:underline">&larr; Kembali ke Modul Tree</a>
      </div>
      <h1 class="text-2xl font-extrabold text-white tracking-tight">Edit Bab / Modul</h1>
      <p class="text-xs text-slate-400 mt-0.5">Kelas: <strong class="text-slate-200"><%= course.title %></strong></p>
    </div>
  </div>

  <div class="bg-slate-900 border border-slate-800 rounded-2xl p-6 sm:p-8 shadow-xl">
    <form action="/admin/courses/<%= course.id %>/modules/<%= moduleItem.id %>/edit" method="POST" class="space-y-5">
      <div>
        <label class="block text-xs font-semibold text-slate-300 mb-1.5">Judul Bab / Modul *</label>
        <input type="text" name="title" required value="<%= moduleItem.title %>" class="w-full px-4 py-2.5 bg-slate-950 border border-slate-800 rounded-xl text-sm text-slate-100 focus:outline-none focus:border-indigo-500">
      </div>

      <div>
        <label class="block text-xs font-semibold text-slate-300 mb-1.5">Parent Modul (Hierarki Pohon)</label>
        <select name="parent_id" class="w-full px-4 py-2.5 bg-slate-950 border border-slate-800 rounded-xl text-sm text-slate-200 focus:outline-none focus:border-indigo-500">
          <option value="">-- Bab Utama (Root) --</option>
          <% const options = (typeof parentOptions !== 'undefined' ? parentOptions : (typeof parentModules !== 'undefined' ? parentModules : [])); %>
          <% options.forEach(p => { %>
            <option value="<%= p.id %>" <%= moduleItem.parent_id === p.id ? 'selected' : '' %>>Sub dari: <%= p.title %></option>
          <% }) %>
        </select>
        <span class="text-[11px] text-slate-500 mt-1 block">Kosongkan jika ingin dijadikan bab tingkat atas.</span>
      </div>

      <div>
        <label class="block text-xs font-semibold text-slate-300 mb-1.5">Urutan (Order Index)</label>
        <input type="number" name="order_index" value="<%= moduleItem.order_index %>" class="w-full px-4 py-2.5 bg-slate-950 border border-slate-800 rounded-xl text-sm text-slate-100 focus:outline-none focus:border-indigo-500">
      </div>

      <div class="pt-4 border-t border-slate-800 flex items-center justify-end gap-3">
        <a href="/admin/courses/<%= course.id %>/modules" class="px-5 py-2.5 text-xs font-semibold text-slate-400 hover:text-white transition-colors">Batal</a>
        <button type="submit" class="px-6 py-2.5 bg-indigo-600 hover:bg-indigo-500 text-white font-semibold rounded-xl text-xs shadow-lg shadow-indigo-600/25 transition-all flex items-center gap-2">
          <i data-lucide="save" class="w-4 h-4"></i> Simpan Perubahan
        </button>
      </div>
    </form>
  </div>
</div>
