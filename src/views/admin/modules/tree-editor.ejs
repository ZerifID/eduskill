<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
  <!-- Header -->
  <div class="mb-8 flex flex-col md:flex-row md:items-center md:justify-between gap-4">
    <div>
      <div class="flex items-center gap-2 text-xs text-indigo-400 font-semibold mb-1">
        <a href="/admin/courses" class="hover:underline">Manajemen Kelas</a>
        <span>/</span>
        <span>Modul Tree Editor</span>
      </div>
      <h1 class="text-2xl font-extrabold text-white tracking-tight"><%= course.title %></h1>
      <p class="text-xs text-slate-400 mt-0.5">Susun hierarki modul & materi belajar (Format: Teks / Artikel & Video, bisa set Free Preview 🔓 atau Locked 🔒).</p>
    </div>
    <div class="flex items-center gap-3">
      <a href="/admin/courses/<%= course.id %>/edit" class="inline-flex items-center gap-2 px-3.5 py-2 bg-amber-500/10 hover:bg-amber-500/20 text-amber-300 text-xs font-semibold rounded-xl border border-amber-500/30 transition-colors">
        <i data-lucide="award" class="w-4 h-4 text-amber-400"></i> Edit Tugas Akhir & Kelas
      </a>
      <a href="/course/<%= course.slug %>" target="_blank" class="inline-flex items-center gap-2 px-3.5 py-2 bg-slate-800 hover:bg-slate-700 text-slate-200 text-xs font-semibold rounded-xl border border-slate-700 transition-colors">
        <i data-lucide="external-link" class="w-4 h-4"></i> Preview Siswa
      </a>
    </div>
  </div>

  <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
    
    <!-- Left Column: Modul Tree Visualizer -->
    <div class="lg:col-span-2 space-y-4">
      
      <!-- Box Info Pengaturan Tugas Akhir Aktif -->
      <div class="p-4 bg-gradient-to-r from-amber-500/10 via-slate-900 to-slate-900 border border-amber-500/20 rounded-2xl flex items-center justify-between">
        <div class="flex items-center gap-3">
          <div class="w-9 h-9 rounded-xl bg-amber-500/20 text-amber-400 flex items-center justify-center">
            <i data-lucide="award" class="w-5 h-5"></i>
          </div>
          <div>
            <span class="text-[10px] font-bold text-amber-400 uppercase tracking-wider block">Syarat Kelulusan Siswa</span>
            <h4 class="text-xs font-bold text-white"><%= course.final_project_title || 'Proyek Tugas Akhir' %></h4>
          </div>
        </div>
        <a href="/admin/courses/<%= course.id %>/edit" class="text-xs font-semibold text-amber-400 hover:text-amber-300 hover:underline flex items-center gap-1">
          Ubah Instruksi &rarr;
        </a>
      </div>

      <div class="bg-slate-900 border border-slate-800 rounded-2xl p-6 shadow-xl">
        <div class="flex items-center justify-between mb-4 border-b border-slate-800 pb-3">
          <h2 class="text-sm font-bold text-white flex items-center gap-2">
            <i data-lucide="network" class="w-4 h-4 text-indigo-400"></i> Struktur Pohon Modul & Materi (Tree View)
          </h2>
          <span class="text-xs text-slate-400"><%= moduleTree.length %> Bab Utama</span>
        </div>

        <% if (moduleTree.length === 0) { %>
          <div class="py-12 text-center text-slate-500">
            <i data-lucide="folder-plus" class="w-10 h-10 mx-auto mb-2 text-slate-600"></i>
            <p class="text-xs font-medium">Belum ada modul di kelas ini.</p>
            <p class="text-[11px] text-slate-600">Gunakan form di samping kanan untuk menambahkan Bab / Modul pertama.</p>
          </div>
        <% } %>

        <div class="space-y-4">
          <% moduleTree.forEach((m, mIdx) => { %>
            <div class="border border-slate-800 rounded-xl bg-slate-950/60 overflow-hidden">
              <!-- Root Module Header -->
              <div class="px-4 py-3 bg-slate-800/40 border-b border-slate-800/60 flex items-center justify-between">
                <div class="flex items-center gap-2.5">
                  <span class="w-6 h-6 rounded-lg bg-indigo-600/20 text-indigo-400 text-xs font-bold flex items-center justify-center border border-indigo-500/20">
                    <%= mIdx + 1 %>
                  </span>
                  <span class="font-bold text-sm text-slate-100"><%= m.title %></span>
                </div>
                <div class="flex items-center gap-2">
                  <a href="/admin/courses/<%= course.id %>/modules/<%= m.id %>/edit" class="p-1.5 text-slate-400 hover:text-indigo-300 transition-colors" title="Edit Judul/Urutan Modul">
                    <i data-lucide="pencil" class="w-4 h-4"></i>
                  </a>
                  <form action="/admin/courses/<%= course.id %>/modules/<%= m.id %>/delete" method="POST" onsubmit="return confirm('Hapus bab ini dan semua materinya?')">
                    <button type="submit" class="p-1.5 text-slate-500 hover:text-rose-400 transition-colors" title="Hapus Bab">
                      <i data-lucide="trash" class="w-4 h-4"></i>
                    </button>
                  </form>
                </div>
              </div>

              <!-- Lessons inside root module -->
              <div class="p-3 space-y-2">
                <% if (m.lessons.length === 0 && m.submodules.length === 0) { %>
                  <p class="text-[11px] text-slate-600 italic px-2 py-1">Belum ada materi di bab ini.</p>
                <% } %>

                <% m.lessons.forEach((l) => { %>
                  <div class="flex items-center justify-between px-3 py-2.5 bg-slate-900/80 border border-slate-800/60 rounded-lg hover:border-slate-700 transition-colors">
                    <div class="flex items-center gap-3">
                      <i data-lucide="<%= l.content_type === 'video' ? 'circle-play' : 'file-text' %>" class="w-4 h-4 <%= l.content_type === 'video' ? 'text-indigo-400' : 'text-amber-400' %>"></i>
                      <div>
                        <span class="text-xs text-slate-200 font-medium"><%= l.title %></span>
                        <span class="text-[10px] text-slate-500 ml-1.5">(<%= l.content_type === 'video' ? 'Video' : 'Teks/Artikel' %>)</span>
                      </div>
                      <% if (l.is_preview === 1) { %>
                        <span class="px-2 py-0.5 rounded text-[10px] font-bold bg-emerald-500/10 text-emerald-400 border border-emerald-500/20 flex items-center gap-1">
                          <i data-lucide="lock-open" class="w-3 h-3"></i> Free Preview
                        </span>
                      <% } else { %>
                        <span class="px-2 py-0.5 rounded text-[10px] font-bold bg-slate-800 text-slate-400 flex items-center gap-1">
                          <i data-lucide="lock" class="w-3 h-3"></i> Locked
                        </span>
                      <% } %>
                    </div>
                    
                    <div class="flex items-center gap-2">
                      <a href="/admin/courses/<%= course.id %>/lessons/<%= l.id %>/edit" class="p-1 text-slate-400 hover:text-indigo-300 transition-colors" title="Edit Isi Materi">
                        <i data-lucide="pencil" class="w-3.5 h-3.5"></i>
                      </a>
                      <form action="/admin/courses/<%= course.id %>/lessons/<%= l.id %>/delete" method="POST" onsubmit="return confirm('Hapus materi ini?')">
                        <button type="submit" class="p-1 text-slate-600 hover:text-rose-400 transition-colors" title="Hapus Materi">
                          <i data-lucide="trash" class="w-3.5 h-3.5"></i>
                        </button>
                      </form>
                    </div>
                  </div>
                <% }) %>

                <!-- Sub-modules (Tree Branch) -->
                <% m.submodules.forEach((sub) => { %>
                  <div class="ml-6 mt-3 border-l-2 border-indigo-500/40 pl-3 space-y-2">
                    <div class="flex items-center justify-between py-1">
                      <span class="text-xs font-semibold text-indigo-300 flex items-center gap-1.5">
                        <i data-lucide="corner-down-right" class="w-3.5 h-3.5"></i> <%= sub.title %> (Sub-Bab)
                      </span>
                      <div class="flex items-center gap-1.5">
                        <a href="/admin/courses/<%= course.id %>/modules/<%= sub.id %>/edit" class="p-1 text-slate-400 hover:text-indigo-300" title="Edit Sub-Bab">
                          <i data-lucide="pencil" class="w-3.5 h-3.5"></i>
                        </a>
                        <form action="/admin/courses/<%= course.id %>/modules/<%= sub.id %>/delete" method="POST" onsubmit="return confirm('Hapus sub-bab ini?')">
                          <button type="submit" class="p-1 text-slate-600 hover:text-rose-400 transition-colors">
                            <i data-lucide="trash" class="w-3.5 h-3.5"></i>
                          </button>
                        </form>
                      </div>
                    </div>

                    <% sub.lessons.forEach(subL => { %>
                      <div class="flex items-center justify-between px-3 py-2 bg-slate-900/60 border border-slate-800/60 rounded-lg">
                        <div class="flex items-center gap-2.5">
                          <i data-lucide="<%= subL.content_type === 'video' ? 'circle-play' : 'file-text' %>" class="w-3.5 h-3.5 <%= subL.content_type === 'video' ? 'text-indigo-400' : 'text-amber-400' %>"></i>
                          <span class="text-xs text-slate-300"><%= subL.title %></span>
                          <% if (subL.is_preview === 1) { %>
                            <span class="text-[9px] font-bold text-emerald-400 px-1.5 py-0.5 bg-emerald-500/10 rounded">Free Preview</span>
                          <% } else { %>
                            <span class="text-[9px] font-bold text-slate-500 px-1.5 py-0.5 bg-slate-800 rounded">Locked</span>
                          <% } %>
                        </div>
                        <div class="flex items-center gap-2">
                          <a href="/admin/courses/<%= course.id %>/lessons/<%= subL.id %>/edit" class="p-1 text-slate-400 hover:text-indigo-300" title="Edit Isi Materi">
                            <i data-lucide="pencil" class="w-3.5 h-3.5"></i>
                          </a>
                          <form action="/admin/courses/<%= course.id %>/lessons/<%= subL.id %>/delete" method="POST" onsubmit="return confirm('Hapus materi ini?')">
                            <button type="submit" class="p-1 text-slate-600 hover:text-rose-400 transition-colors">
                              <i data-lucide="trash" class="w-3.5 h-3.5"></i>
                            </button>
                          </form>
                        </div>
                      </div>
                    <% }) %>
                  </div>
                <% }) %>
              </div>
            </div>
          <% }) %>
        </div>
      </div>
    </div>

    <!-- Right Column: Add Module & Lesson Forms -->
    <div class="space-y-6">
      <!-- Form 1: Tambah Modul / Sub-Modul (Tree Node) -->
      <div class="bg-slate-900 border border-slate-800 rounded-2xl p-6 shadow-xl">
        <h3 class="text-sm font-bold text-white mb-4 flex items-center gap-2">
          <i data-lucide="folder-plus" class="w-4 h-4 text-indigo-400"></i> 1. Tambah Bab / Modul
        </h3>
        <form action="/admin/courses/<%= course.id %>/modules/add" method="POST" class="space-y-4">
          <div>
            <label class="block text-xs font-semibold text-slate-300 mb-1">Judul Bab / Modul *</label>
            <input type="text" name="title" required placeholder="Contoh: Bab 1: Dasar HTML & CSS" class="w-full px-3.5 py-2 bg-slate-950 border border-slate-800 rounded-xl text-xs text-slate-100 placeholder-slate-500 focus:outline-none focus:border-indigo-500">
          </div>

          <div>
            <label class="block text-xs font-semibold text-slate-300 mb-1">Parent Modul (Opsional)</label>
            <select name="parent_id" class="w-full px-3.5 py-2 bg-slate-950 border border-slate-800 rounded-xl text-xs text-slate-200 focus:outline-none focus:border-indigo-500">
              <option value="">-- Jadikan Bab Utama (Root) --</option>
              <% modules.filter(m => !m.parent_id).forEach(m => { %>
                <option value="<%= m.id %>">Sub dari: <%= m.title %></option>
              <% }) %>
            </select>
            <span class="text-[10px] text-slate-500 mt-1 block">Pilih parent jika ingin membuat cabang sub-modul di dalam pohon.</span>
          </div>

          <div>
            <label class="block text-xs font-semibold text-slate-300 mb-1">Urutan (Order Index)</label>
            <input type="number" name="order_index" value="0" class="w-full px-3.5 py-2 bg-slate-950 border border-slate-800 rounded-xl text-xs text-slate-100 focus:outline-none focus:border-indigo-500">
          </div>

          <button type="submit" class="w-full py-2 bg-indigo-600 hover:bg-indigo-500 text-white font-semibold rounded-xl text-xs shadow-md shadow-indigo-600/20 transition-all flex items-center justify-center gap-1.5">
            <i data-lucide="plus" class="w-3.5 h-3.5"></i> Simpan Modul
          </button>
        </form>
      </div>

      <!-- Form 2: Tambah Lesson / Materi Belajar (Teks / Video) -->
      <div class="bg-slate-900 border border-slate-800 rounded-2xl p-6 shadow-xl">
        <h3 class="text-sm font-bold text-white mb-4 flex items-center gap-2">
          <i data-lucide="file-plus" class="w-4 h-4 text-emerald-400"></i> 2. Tambah Materi (Teks / Video)
        </h3>
        <% if (modules.length === 0) { %>
          <p class="text-xs text-slate-500">Silakan buat modul di atas terlebih dahulu sebelum menambahkan materi.</p>
        <% } else { %>
          <form action="/admin/courses/<%= course.id %>/lessons/add" method="POST" class="space-y-4">
            <div>
              <label class="block text-xs font-semibold text-slate-300 mb-1">Pilih Bab / Modul *</label>
              <select name="module_id" required class="w-full px-3.5 py-2 bg-slate-950 border border-slate-800 rounded-xl text-xs text-slate-200 focus:outline-none focus:border-indigo-500">
                <% modules.forEach(m => { %>
                  <option value="<%= m.id %>"><%= m.parent_id ? '↳ ' : '📂 ' %><%= m.title %></option>
                <% }) %>
              </select>
            </div>

            <div>
              <label class="block text-xs font-semibold text-slate-300 mb-1">Judul Materi *</label>
              <input type="text" name="title" required placeholder="Contoh: 01. Konsep Dasar & Panduan Belajar" class="w-full px-3.5 py-2 bg-slate-950 border border-slate-800 rounded-xl text-xs text-slate-100 placeholder-slate-500 focus:outline-none focus:border-indigo-500">
            </div>

            <div class="grid grid-cols-2 gap-3">
              <div>
                <label class="block text-xs font-semibold text-slate-300 mb-1">Format Materi *</label>
                <select name="content_type" id="create_content_type" class="w-full px-3.5 py-2 bg-slate-950 border border-slate-800 rounded-xl text-xs text-slate-200 focus:outline-none focus:border-indigo-500">
                  <option value="text">📄 Teks / Artikel & Gambar</option>
                  <option value="video">🎥 Video (YouTube / MP4)</option>
                </select>
              </div>

              <div>
                <label class="block text-xs font-semibold text-slate-300 mb-1">Urutan</label>
                <input type="number" name="order_index" value="0" class="w-full px-3.5 py-2 bg-slate-950 border border-slate-800 rounded-xl text-xs text-slate-100 focus:outline-none focus:border-indigo-500">
              </div>
            </div>

            <div id="create_video_field" class="hidden">
              <label class="block text-xs font-semibold text-slate-300 mb-1">Link Video (YouTube Embed / MP4)</label>
              <input type="url" name="video_url" placeholder="https://www.youtube.com/embed/..." class="w-full px-3.5 py-2 bg-slate-950 border border-slate-800 rounded-xl text-xs text-slate-100 placeholder-slate-500 focus:outline-none focus:border-indigo-500">
            </div>

            <div>
              <div class="flex items-center justify-between mb-1">
                <label class="block text-xs font-semibold text-slate-300">Isi Materi / Artikel Teks</label>
                <div class="flex items-center gap-1.5">
                  <button type="button" onclick="openMermaidModal('create_body_text_editor')" class="px-2 py-0.5 bg-indigo-600/20 hover:bg-indigo-600/30 text-indigo-300 border border-indigo-500/30 rounded text-[10px] font-semibold flex items-center gap-1 transition-colors">
                    <i data-lucide="git-branch" class="w-3 h-3"></i> 📊 Mermaid
                  </button>
                  <label for="create_lesson_image_upload" class="cursor-pointer px-2 py-0.5 bg-slate-800 hover:bg-slate-700 text-slate-300 border border-slate-700 rounded text-[10px] font-semibold flex items-center gap-1 transition-colors">
                    <i data-lucide="image" class="w-3 h-3"></i> + Gambar
                  </label>
                  <input type="file" id="create_lesson_image_upload" accept="image/*" class="hidden">
                </div>
              </div>
              <div class="relative">
                <textarea id="create_body_text_editor" name="body_text" rows="5" placeholder="Tuliskan materi pelajaran di sini... (Mendukung tag ```mermaid & Ctrl + V paste gambar!)" class="w-full px-3.5 py-2 bg-slate-950 border border-slate-800 rounded-xl text-xs text-slate-100 placeholder-slate-500 focus:outline-none focus:border-indigo-500 font-mono"></textarea>
                <div id="create_upload_indicator" class="hidden absolute bottom-2 right-2 px-2.5 py-1 bg-indigo-600/90 text-white rounded text-[10px] font-semibold flex items-center gap-1.5 animate-pulse">
                  <span class="animate-spin">⏳</span> Uploading...
                </div>
              </div>
            </div>

            <div class="p-3 bg-slate-950 rounded-xl border border-slate-800">
              <label class="flex items-center gap-2.5 cursor-pointer select-none">
                <input type="checkbox" name="is_preview" value="1" class="w-4 h-4 rounded border-slate-800 text-emerald-500 focus:ring-emerald-500 bg-slate-900">
                <span class="text-xs font-bold text-emerald-400 flex items-center gap-1.5">
                  <i data-lucide="lock-open" class="w-3.5 h-3.5"></i> Gratiskan Materi Ini (Free Preview)
                </span>
              </label>
              <span class="text-[10px] text-slate-500 mt-1 block pl-6">Materi ini bisa ditonton/dibaca siapa saja tanpa perlu membeli kelas.</span>
            </div>

            <button type="submit" class="w-full py-2 bg-emerald-600 hover:bg-emerald-500 text-white font-semibold rounded-xl text-xs shadow-md shadow-emerald-600/20 transition-all flex items-center justify-center gap-1.5">
              <i data-lucide="plus" class="w-3.5 h-3.5"></i> Simpan Materi
            </button>
          </form>
        <% } %>
      </div>
    </div>

  </div>
</div>

<script>
  const createTypeSelect = document.getElementById('create_content_type');
  const createVideoField = document.getElementById('create_video_field');
  if (createTypeSelect && createVideoField) {
    createTypeSelect.addEventListener('change', (e) => {
      if (e.target.value === 'video') {
        createVideoField.classList.remove('hidden');
      } else {
        createVideoField.classList.add('hidden');
      }
    });
  }

  // Ctrl+V Paste Image & File Upload Handler for Tree-Editor
  const createTextarea = document.getElementById('create_body_text_editor');
  const createImgUpload = document.getElementById('create_lesson_image_upload');
  const createUploadIndicator = document.getElementById('create_upload_indicator');

  async function uploadImageForCreate(file) {
    if (!file || !file.type.startsWith('image/')) return;
    createUploadIndicator.classList.remove('hidden');

    const formData = new FormData();
    formData.append('image', file);

    try {
      const res = await fetch('/admin/api/upload-image', {
        method: 'POST',
        body: formData
      });
      const data = await res.json();
      if (data.success && data.url) {
        insertTextAtCursor(createTextarea, `\n![Gambar](${data.url})\n`);
      } else {
        alert('Gagal upload: ' + (data.message || 'Error'));
      }
    } catch (err) {
      alert('Upload error: ' + err.message);
    } finally {
      createUploadIndicator.classList.add('hidden');
    }
  }

  function insertTextAtCursor(input, textToInsert) {
    const startPos = input.selectionStart;
    const endPos = input.selectionEnd;
    const currentVal = input.value;
    input.value = currentVal.substring(0, startPos) + textToInsert + currentVal.substring(endPos, currentVal.length);
    input.focus();
    input.selectionStart = startPos + textToInsert.length;
    input.selectionEnd = startPos + textToInsert.length;
  }

  if (createTextarea) {
    createTextarea.addEventListener('paste', (e) => {
      const clipboardData = e.clipboardData || window.clipboardData;
      if (!clipboardData) return;
      const items = clipboardData.items;
      for (let i = 0; i < items.length; i++) {
        if (items[i].type.indexOf('image') !== -1) {
          const file = items[i].getAsFile();
          if (file) {
            e.preventDefault();
            uploadImageForCreate(file);
            break;
          }
        }
      }
    });
  }

  if (createImgUpload) {
    createImgUpload.addEventListener('change', (e) => {
      const file = e.target.files[0];
      if (file) {
        uploadImageForCreate(file);
        createImgUpload.value = '';
      }
    });
  }
</script>

<%- include('../../partials/mermaid-modal') %>
